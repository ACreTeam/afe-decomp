        aSHR_setup_action(shrine, play, aSHR_ACTION_WAIT);
    }
}

typedef void (*aSHR_PROC)(SHRINE_ACTOR*, GAME_PLAY*);
typedef void (*aSHR_INIT_PROC)(SHRINE_ACTOR*, GAME_PLAY*);

static void aSHR_setup_action(SHRINE_ACTOR* shrine, GAME_PLAY* play, int action) {
    static aSHR_INIT_PROC init_proc[aSHR_ACTION_NUM] = {
        aSHR_init_no_proc,
        aSHR_init_no_proc,
        aSHR_init_no_proc,
        (aSHR_INIT_PROC)aSHR_make_hem_init,
        aSHR_init_no_proc,
        aSHR_question_carde_init,
        aSHR_send_carde_program_s_init,
        aSHR_connect_check_to_send_carde_init,
        aSHR_send_carde_program_init,
        aSHR_question_read_init,
        aSHR_read_carde_s_init,
        aSHR_connect_check_to_read_carde_init,
        aSHR_read_carde_init,
        aSHR_question_npc_overwrite_init,
        aSHR_question_npc_overwrite_init,
        aSHR_connect_check_to_check_exist_init,
        aSHR_check_exist_to_trans_init,
        aSHR_upload_init,
        aSHR_send_loader_init,
        aSHR_send_program_init,
        aSHR_send_data_init,
    };

    static aSHR_PROC process[aSHR_ACTION_NUM] = {
        aSHR_wait,
        aSHR_talk,
        aSHR_talk_gomen,
        aSHR_make_hem,
        aSHR_talk_end,
        aSHR_question_carde,
        aSHR_send_carde_program_s,
        aSHR_connect_check_to_send_carde,
        aSHR_send_carde_program,
        aSHR_question_read,
        aSHR_read_carde_s,
        aSHR_connect_check_to_read_carde,
        aSHR_read_carde,
        aSHR_question_npc_overwrite,
        aSHR_question_npc_overwrite,
        aSHR_connect_check_to_check_exist,
        aSHR_check_exist_to_trans,
        aSHR_upload,
        aSHR_send_loader,
        aSHR_send_program,
        aSHR_send_data,
    };

    if (init_proc[action] != NULL) {
        (*init_proc[action])(shrine, play);
    }

    shrine->structure_class.action_proc = (aSTR_MOVE_PROC)process[action];
    shrine->structure_class.action = action;
}

static void aSHR_actor_init(ACTOR* actorx, GAME* game) {
    mFI_SetFG_common(DUMMY_SHRINE, actorx->home.position, FALSE);
    aSHR_actor_move(actorx, game);
    actorx->mv_proc = &aSHR_actor_move;
}

static void aSHR_actor_move(ACTOR* actorx, GAME* game) {
    GAME_PLAY* play = (GAME_PLAY*)game;
    SHRINE_ACTOR* shrine = (SHRINE_ACTOR*)actorx;

    (*(aSHR_PROC)shrine->structure_class.action_proc)(shrine, play);
    sAdo_OngenPos((u32)actorx, 0x5A, &actorx->world.position);
    aSHR_SetTransSE_move(shrine);
}
