static u8 totakeke_str[aMIK_STRING_LEN * aMIK_STRING_NUM];

// clang-format off
static u8 page_table[] = { 0, 2, 4, 7, 12, 19, 25, 28, 33, 39, 46, 49, 52, 59, 66, 68 };
// clang-format on

// clang-format off
static u8 index_line_table[] = { 2, 4, 7, 12, 15, 19, 22, 25, 28, 33, 39, 46, 49, 52, 57, 59, 62, 66 };
// clang-format on

static int aMKBC_get_alpha(int timer, int start, int end) {
    int alpha;
    if (timer < start || timer > end) alpha = 0;
    else if (timer < (s16)(start + 80)) alpha = (u8)((timer - start) * 3.1875f);
    else if (timer > (s16)(end - 80)) alpha = (u8)((end - timer) * 3.1875f);
    else alpha = 255;
    return alpha;
}

static int aMKBC_get_alpha_bdm(int timer) {
    int alpha = 255;
    if (timer <= 40) alpha = timer * 6.375f;
    return alpha;
}

static void aMKBC_clip_set_string(int base) {
    if (CLIP(mikanbox_clip) != NULL) {
        u8* str_p = totakeke_str;
        int page = mString_MIKANBOX_START + page_table[base];
        int i;

        for (i = 0; i < aMIK_STRING_NUM; i++) {
            mString_Load_StringFromRom(str_p, aMIK_STRING_LEN, page);

            page++;
            if (page > mString_MIKANBOX_END) {
                page = mString_MIKANBOX_END;
            }

            str_p += aMIK_STRING_LEN;
        }
    }
}

static void aMKBC_clip_roll_draw(GAME_PLAY* play, int timer, int page) {
    GAME* game = (GAME*)play;
    GRAPH* graph = game->graph;
    int i;
    int j;
    int k;
    int start_idx;
    int end_idx;
    u8* str_p;
    f32 scale;
    f32 pos_y;
    int alpha;
    if (!(Common_Get(event_common).exist_flags1 & aNTT_FLAG_SP_ROLL_DRAW) || CLIP(mikanbox_clip) == NULL) {
        return;
    } else {
        str_p = totakeke_str;
        mFont_SetMatrix(graph, mFont_MODE_FONT);
        start_idx = page_table[page];
        end_idx = page_table[page + 1];
        alpha = aMKBC_get_alpha(timer, 40, 475);
        pos_y = 30.0f;
        pos_y += ((start_idx + 10) - end_idx) * 10.0f;
        for (i = 0, j = start_idx; i < aMIK_STRING_NUM && j < end_idx; i++, j++) {
            int len;
            scale = 0.9f;
            for (k = 0; k < ARRAY_COUNT(index_line_table); k++) {
                if (index_line_table[k] == j) scale *= 0.85f;
            }
            len = mMsg_Get_Length_String(str_p, aMIK_STRING_LEN);
            mFont_SetLineStrings_AndSpace(game, str_p, len, 150.0f, pos_y + i * 18.0f, 255, 255, 255, alpha,
                FALSE, FALSE, TRUE, scale, scale, mFont_MODE_FONT);
            str_p += aMIK_STRING_LEN;
        }
        mFont_UnSetMatrix(graph, mFont_MODE_FONT);
    }
}

static int aNTT_draw_chk_proc(ACTOR* actorx, GAME_PLAY* play) {
    s16 profile = actorx->id;
    mActor_name_t name = actorx->npc_id;

    if (profile == mAc_PROFILE_PLAYER || profile == mAc_PROFILE_WEATHER || profile == mAc_PROFILE_EFFECT_CONTROL ||
        name == SP_NPC_TOTAKEKE || name == SP_NPC_TOTAKEKE_BIRTHDAY || name == MIKANBOX || name == SP_NPC_MAJIN5) {
        return FALSE;
    }

    // force cull all other actors
    actorx->state_bitfield &= ~ACTOR_STATE_NO_CULL;
    return TRUE;
}

static void aNTT_set_string(NPC_TOTAKEKE_ACTOR* kk) {

    aMKBC_clip_set_string(kk->_9a2);
    kk->roll2_count = 0;
    Common_Get(event_common).exist_flags1 |= aNTT_FLAG_SP_ROLL_DRAW;
}

static void aNTT_roll_init(NPC_TOTAKEKE_ACTOR* kk, GAME_PLAY* play) {

    mBGMPsComp_make_ps_quiet(0x168);
    staffroll_light_init(play);
    kk->roll_count = 180;
    
    if (CLIP(weather_clip) != NULL) {
        CLIP(weather_clip)->change_weather(CLIP(weather_clip)->actor, mEnv_WEATHER_CLEAR, mEnv_WEATHER_INTENSITY_NONE);
    }

    Common_Get(event_common).exist_flags1 &= ~aNTT_FLAG_SP_ROLL_END;
    kk->_9a0 = 255;
    kk->show_timer = 0;
    Common_Get(event_common).mikanbox_light_radius = 120;
    kk->_9aa = 0;
    kk->npc_class.condition_info.demo_flg = aNPC_COND_DEMO_SKIP_HEAD_LOOKAT;
}

static void aNTT_roll1_init(NPC_TOTAKEKE_ACTOR* kk, GAME_PLAY* play) {
    u16 bgm_no = CLIP(mikanbox_clip)->bgm_no_proc(kk);

    mBGMPsComp_make_ps_demo(bgm_no, 0x168);
    mBGMPsComp_delete_ps_quiet();
    kk->npc_class.condition_info.demo_flg = aNPC_COND_DEMO_SKIP_KUTIPAKU | aNPC_COND_DEMO_SKIP_HEAD_LOOKAT;
    Camera2_request_main_staff_roll(play, GET_PLAYER_ACTOR_ACTOR(play), (ACTOR*)kk, 5, CAMERA2_PROCESS_STAFF_ROLL, 0);
    play->draw_chk_proc = &aNTT_draw_chk_proc;
}

static void aNTT_bdmsg_1_init(NPC_TOTAKEKE_ACTOR* kk, GAME_PLAY* play) {
    u16 bgm_no;
    kk->birthday_msg_num = mBm_get_validity_birthday_msg_num();
    kk->birthday_msg_idx = 0;
    bgm_no = CLIP(mikanbox_clip)->bgm_no_proc(kk);
    mBGMPsComp_make_ps_demo(bgm_no, 0x168);
    mBGMPsComp_delete_ps_quiet();
    kk->npc_class.condition_info.demo_flg = aNPC_COND_DEMO_SKIP_KUTIPAKU | aNPC_COND_DEMO_SKIP_HEAD_LOOKAT;
    Camera2_request_main_staff_roll(play, GET_PLAYER_ACTOR_ACTOR(play), (ACTOR*)kk, 5, CAMERA2_PROCESS_STAFF_ROLL2, kk->birthday_msg_num);
    play->draw_chk_proc = &aNTT_draw_chk_proc;
}

extern void aNTT_bdmsg_h_start(NPC_TOTAKEKE_ACTOR* kk, GAME_PLAY* play) {
    u16* buf = (u16*)mTxt_get_first_buff();
    mPr_birthday_msg_c* msg;
    kk->roll2_count = 0;
    Common_Get(event_common).exist_flags1 |= aNTT_FLAG_BIRTHDAY_HEADER;
    msg = mBm_get_validity_birthday_msg(kk->birthday_msg_idx);
    mTxt_conv_16bit(msg->header, buf, MAIL_HEADER_LEN);
}

extern void aNTT_bdmsg_b_start(NPC_TOTAKEKE_ACTOR* kk, GAME_PLAY* play) {
    u16* buf = (u16*)mTxt_get_first_buff();
    mPr_birthday_msg_c* msg;
    kk->roll2_count = 0;
    Common_Get(event_common).exist_flags1 |= aNTT_FLAG_BIRTHDAY_BODY;
