static void aSHR_check_exist_to_trans(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    int status = mGcgba_IsGame();
    mMsg_Set_LockContinue(mMsg_Get_base_window_p());
    switch (status) {
        case GBA2_GBA_STATE_SUCCESS:
            aSHR_setup_action(shrine, play, aSHR_ACTION_UPLOAD);
            break;
        case GBA2_GBA_STATE_ALREADY_EXIST:
            aSHR_setup_action(shrine, play, aSHR_ACTION_SEND_LOADER);
            break;
        case GBA2_GBA_STATE_ERROR:
            aSHR_setup_action(shrine, play, aSHR_ACTION_SEND_LOADER);
            break;
    }
