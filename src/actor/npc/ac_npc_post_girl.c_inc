static void aPG_repay_after_init(ACTOR* actorx, GAME* game) {
    NPC_POSTGIRL_ACTOR* postgirl = (NPC_POSTGIRL_ACTOR*)actorx;
    static int msg_no[8] = { 0x31d7, 0x31d5, 0x8db, 0x8d9, 0x8df, 0x8dd, 0x8db, 0x8d9 };
    aPG_set_post_status(postgirl);
    aPG_Set_continue_msg_num(postgirl, msg_no[postgirl->status]);
}

static void aPG_card_chk_condition_before_init(ACTOR* actorx, GAME* game) {
    mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
}

static void aPG_card_chk_condition_init(ACTOR* actorx, GAME* game) {
    NPC_POSTGIRL_ACTOR* postgirl = (NPC_POSTGIRL_ACTOR*)actorx;
    GAME_PLAY* play = (GAME_PLAY*)game;
    int slot;
    int land_slot;
    mMsg_SET_LOCKCONTINUE();
    aPG_ban_shutter(postgirl, play);
    land_slot = mCD_GetThisLandSlotNo();
    slot = mCD_SLOT_A;
    if (land_slot == mCD_SLOT_A || land_slot == mCD_SLOT_B) {
        slot = land_slot;
    } else if (Common_Get(memcard_slot) == mCD_SLOT_A || Common_Get(memcard_slot) == mCD_SLOT_B) {
        slot = Common_Get(memcard_slot);
    }
    aPG_set_slot_name(slot, mMsg_FREE_STR3);
    if (slot == mCD_SLOT_A) {
        aPG_set_slot_name(mCD_SLOT_B, mMsg_FREE_STR5);
    } else {
        aPG_set_slot_name(mCD_SLOT_A, mMsg_FREE_STR5);
    }
}

static void aPG_card_save_menu_close_wait_init(ACTOR* actorx, GAME* game) {
    NPC_POSTGIRL_ACTOR* postgirl = (NPC_POSTGIRL_ACTOR*)actorx;
    GAME_PLAY* play = (GAME_PLAY*)game;
    Submenu* submenu = &play->submenu;
    Mail_c* src;
    Mail_c* dst = postgirl->saved_mail;
    int i;
    src = Now_Private->mail;
    for (i = 0; i < mPr_INVENTORY_MAIL_COUNT; i++) {
        mMl_copy_mail(dst, src);
        src++;
        dst++;
    }
    mSM_open_submenu_new(submenu, mSM_OVL_INVENTORY, mSM_IV_OPEN_CPMAIL, 0, postgirl->card_mail);
    mMl_clear_mail(&submenu->mail);
}

