static void aSHR_read_carde_init(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    aSHR_InitVar(shrine, play);
    aSHR_SetTransSE(shrine);
}

static void aSHR_read_carde(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    int msg_no;
    int status = mGcgba_Read(aSHR_carde_receive, sizeof(aSHR_carde_receive), GBA2_EAPPLI_TYPE_PTERMINAL);
    int animal_num = mNpc_GetAnimalNum();
    u16 info = (aSHR_carde_receive[0] << 8) | aSHR_carde_receive[1];
    switch (status) {
        case GBA2_GBA_STATE_SUCCESS:
            aSHR_EndComm(shrine, play);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            if (mEA_animal_carde_info_to_npc_no(info) == EMPTY_NO &&
                !mEA_animal_carde_info_to_check_special_npc(info)) {
                decode_szs(aSHR_carde_receive + 0x95, aSHR_decode_work_30k);
            }
            if (mEA_animal_carde_info_to_check_special_npc(info)) {
                msg_no = 0x2067;
                aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
            } else if (aSHR_check_npc_live_in_this_world(info, (AnimalInfo_c*)aSHR_decode_work_30k)) {
                msg_no = 0x2066;
                aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
            } else if (animal_num == ANIMAL_NUM_MAX &&
                       aSHR_read_data_to_village_npc_type(info, (AnimalInfo_c*)aSHR_decode_work_30k) == TRUE) {
                msg_no = 0x2062;
                aSHR_setup_action(shrine, play, aSHR_ACTION_QUESTION_NPC_OVERWRITE);
            } else if (aSHR_exist_my_island() == FALSE &&
                       aSHR_read_data_to_village_npc_type(info, (AnimalInfo_c*)aSHR_decode_work_30k) == FALSE) {
                msg_no = 0x2065;
                aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
            } else if (aSHR_check_my_island_npc_exist() == TRUE &&
                       aSHR_read_data_to_village_npc_type(info, (AnimalInfo_c*)aSHR_decode_work_30k) == FALSE) {
                msg_no = 0x2064;
                aSHR_setup_action(shrine, play, aSHR_ACTION_QUESTION_ISLAND_NPC_OVERWRITE);
            } else {
                aSHR_request_reserve_add_npc();
                msg_no = 0x2061;
                aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
            }
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), msg_no);
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            break;
        case GBA2_GBA_STATE_TRANSMITTING:
            aSHR_SetTransSE(shrine);
            break;
        default:
            aSHR_EndComm(shrine, play);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x2060);
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
            break;
    }
}

static void aSHR_question_npc_overwrite_init(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    mChoice_Clear_ChoseNum(mChoice_Get_base_window_p());
}

static void aSHR_question_npc_overwrite(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    int choice = mChoice_Get_ChoseNum(mChoice_Get_base_window_p());
    if (choice != -1 && mMsg_Check_MainNormalContinue(mMsg_Get_base_window_p())) {
        switch (choice) {
            case mChoice_CHOICE0: {
                aSHR_request_reserve_add_npc();
                if (shrine->structure_class.action == aSHR_ACTION_QUESTION_ISLAND_NPC_OVERWRITE) {
                    int idx = mHS_get_arrange_idx(Common_Get(player_no));
                    Island_c* island = &Save_Get(homes[idx]).island;
                    if (mISL_GetNpcDayType(island) == mISL_NPC_DAY_TYPE_NORMAL) {
                        island->islander_spawn_date.year = 0x8000;
                        island->islander_spawn_date.month = 0x80;
                        island->islander_spawn_date.day = 0x80;
                    }
                }
                aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
                aSHR_EndComm(shrine, play);
                break;
            }
            default:
                aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
                aSHR_EndComm(shrine, play);
                break;
        }
    }
}

