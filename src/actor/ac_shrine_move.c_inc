    aSHR_SetTransSE(shrine);
}

static void aSHR_send_carde_program(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    size_t size = mEA_dl_carde_program_size();
    u8* data = mEA_dl_carde_program_p();
    int status = mGcgba_send_eAppri(data, size);
    switch (status) {
        case GBA2_EAPPLI_SUCCESS:
            aSHR_InitVar(shrine, play);
            aSHR_EndComm(shrine, play);
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x205C);
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            aSHR_setup_action(shrine, play, aSHR_ACTION_QUESTION_READ);
            break;
        case GBA2_EAPPLI_FAILURE_XFER_ERROR:
        case GBA2_EAPPLI_FAILURE_NO_GBA:
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x205D);
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            aSHR_EndComm(shrine, play);
            aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
            break;
        default:
            aSHR_SetTransSE(shrine);
            break;
    }
}

