enum {
    aSEN_TALK_END_WAIT,
    aSEN_TALK_CHK_RIDE_ON_V,
    aSEN_TALK_SELECT_ISLAND,
    aSEN_TALK_CONFIRM_DESTINATION,
    aSEN_TALK_SING_END_WAIT,
    aSEN_TALK_CHK_RIDE_ON_I,
    aSEN_TALK_PASSAGE_PERMISSION_CHECK,
    aSEN_TALK_PRESENT_START_WAIT,
    aSEN_TALK_PRESENT_TRANS_TAKEOUT,
    aSEN_TALK_PRESENT_TRANS_WAIT,
    aSEN_TALK_NUM,
    aSEN_TALK_NONE = 0xFF
};

enum {
    aSEN_ACTION_NO_ISLAND,
    aSEN_ACTION_MY_ISLAND,
    aSEN_ACTION_OTHER_ISLAND,
    aSEN_ACTION_SELECT_ISLAND,
    aSEN_ACTION_FIRST_MEETING,
    aSEN_ACTION_EXPLAIN_ISLAND,
    aSEN_ACTION_APRILFOOL,
    aSEN_ACTION_TALK_START_WAIT_I,
    aSEN_ACTION_PL_RIDE_ON_END_WAIT,
    aSEN_ACTION_START_CALL_V,
    aSEN_ACTION_START_CALL_I,
    aSEN_ACTION_SING_START_WAIT,
    aSEN_ACTION_SING_V,
    aSEN_ACTION_SING_I,
    aSEN_ACTION_TOUCH_WHARF_START_WAIT,
    aSEN_ACTION_TOUCH_WHARF_END_WAIT,
    aSEN_ACTION_ARRIVE_V,
    aSEN_ACTION_ARRIVE_MY_ISLAND,
    aSEN_ACTION_ARRIVE_OTHER_ISLAND,
    aSEN_ACTION_PL_RIDE_OFF_END_WAIT,
    aSEN_ACTION_OUT_OF_SERVICE_V,
    aSEN_ACTION_OUT_OF_SERVICE_I,
    aSEN_ACTION_NUM
};

enum {
    aSEN_NORM_TALK_NO_ISLAND,
    aSEN_NORM_TALK_MY_ISLAND,
    aSEN_NORM_TALK_OTHER_ISLAND,
    aSEN_NORM_TALK_SELECT_ISLAND,
    aSEN_NORM_TALK_FIRST_MEETING,
    aSEN_NORM_TALK_EXPLAIN_ISLAND,
    aSEN_NORM_TALK_APRILFOOL,
    aSEN_NORM_TALK_RIDE_ON_I,
    aSEN_NORM_TALK_OUT_OF_SERVICE_V,
    aSEN_NORM_TALK_OUT_OF_SERVICE_I,
    aSEN_NORM_TALK_NUM
};

enum {
    aSEN_FORCE_TALK_START_CALL_V,
    aSEN_FORCE_TALK_START_CALL_I,
    aSEN_FORCE_TALK_SING_V,
    aSEN_FORCE_TALK_SING_I,
    aSEN_FORCE_TALK_ARRIVE_V,
    aSEN_FORCE_TALK_ARRIVE_MY_ISLAND,
    aSEN_FORCE_TALK_ARRIVE_OTHER_ISLAND,
    aSEN_FORCE_TALK_NUM
};

typedef struct npc_sendo_think_setup_s {
    aSEN_PROC think_proc;
    aSEN_PROC think_init_proc;
    aNPC_TALK_REQUEST_PROC talk_request_proc;
    u8 talk_act;
    u8 next_action;
    int animation_id;
} aSEN_think_setup_c;

typedef struct npc_sendo_talk_request_s {
    int msg_no;
    u8 player_talk_turn;
    u8 msg_camera_type;
    u8 sendo_talk_turn;
    u8 talk_act;
} aSEN_talk_request_c;

static void aSEN_set_anime_current(NPC_SENDO_ACTOR* sendo_actor) {
    f32 length;
    f32 start;
    f32 a;

    start = sendo_actor->npc_class.draw.main_animation.keyframe.frame_control.start_frame;
    length = sendo_actor->npc_class.draw.main_animation.keyframe.frame_control.end_frame - start;
    a = (start + sendo_actor->anime_progress * length) -
        sendo_actor->npc_class.draw.main_animation.keyframe.frame_control.current_frame;

    if (a < 0) {
        a += length;
    }

    sendo_actor->npc_class.draw.main_animation.keyframe.frame_control.speed = a;
}

static void aSEN_set_request_act(NPC_SENDO_ACTOR* sendo) {
    sendo->npc_class.request.act_priority = 4;
    sendo->npc_class.request.act_idx = aNPC_ACT_SPECIAL;
    sendo->npc_class.request.act_type = aNPC_ACT_TYPE_SEARCH;
}

static int aSEN_make_home_list(NPC_SENDO_ACTOR* sendo) {
    mHm_hs_c* home = Save_Get(homes);
    int i;
    int count = 0;
    for (i = 0; i < PLAYER_NUM; i++, home++) {
        if (home->island.flags.unlocked == TRUE &&
            (home->island.flags._1 == TRUE ||
             mPr_CheckCmpPersonalID(&home->ownerID, &Now_Private->player_ID) == TRUE)) {
            sendo->island_homes[count] = home;
            count++;
        }
    }
    return count;
}

static int aSEN_chk_my_island(void) {
    int res = FALSE;
    if (!mLd_PlayerManKindCheck() &&
        Save_Get(homes[mHS_get_arrange_idx(Common_Get(player_no))]).size_info.next_size >= mHm_HOMESIZE_ISLAND) {
        res = TRUE;
    }
    return res;
}

static int aSEN_chk_island_talk(void) {
    int res = FALSE;
    if (!mLd_PlayerManKindCheck()) {
        int idx = mHS_get_arrange_idx(Common_Get(player_no));
        if (Save_Get(homes[idx]).size_info.next_size >= mHm_HOMESIZE_ISLAND &&
            !(Now_Private->state_flags & aSEN_ISLAND_EXPLAINED))
            res = TRUE;
    }
    return res;
}

static u8 aSEN_get_talk_start_wait_v_think_idx_sub(NPC_SENDO_ACTOR* sendo) {
    u8 act;
    if (sendo->island_count == 0)
        act = aSEN_ACTION_NO_ISLAND;
    else if (sendo->island_count == 1) {
        if (sendo->has_my_island == TRUE)
            act = aSEN_ACTION_MY_ISLAND;
        else
            act = aSEN_ACTION_OTHER_ISLAND;
    } else
        act = aSEN_ACTION_SELECT_ISLAND;
    return act;
}

static u8 aSEN_get_talk_start_wait_v_think_idx(NPC_SENDO_ACTOR* sendo) {
    u8 act;
    if (!mLd_PlayerManKindCheck()) {
        if (!(Now_Private->state_flags & aSEN_MET_SENDO)) {
            act = aSEN_ACTION_FIRST_MEETING;
            Now_Private->state_flags |= aSEN_MET_SENDO;
        } else if (aSEN_chk_island_talk() == TRUE) {
            act = aSEN_ACTION_EXPLAIN_ISLAND;
            Now_Private->state_flags |= aSEN_ISLAND_EXPLAINED;
        } else if (CLIP(aprilfool_control_clip) != NULL &&
                   CLIP(aprilfool_control_clip)->talk_chk_proc(SP_NPC_SENDO) == FALSE) {
            act = aSEN_ACTION_APRILFOOL;
        } else {
            act = aSEN_get_talk_start_wait_v_think_idx_sub(sendo);
        }
    } else {
        act = aSEN_get_talk_start_wait_v_think_idx_sub(sendo);
    }
    return act;
}

static void aSEN_pl_ride_on_end_wait(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;
    u8 act;

    if (boat_demo->action == aBTD_ACTION_START_CALL_END_WAIT) {
        if (boat_demo->at_island == FALSE) {
            mISL_ClearNowPlayerAction_island();

            act = aSEN_ACTION_START_CALL_V;
        } else {
            act = aSEN_ACTION_START_CALL_I;
        }

        aSEN_setup_think_proc(sendo, play, act);
    }
}

static void aSEN_sing_start_wait(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;
    u8 act;

    if (boat_demo->action == aBTD_ACTION_SING_SENDO_MSG_SET_WAIT) {
        if (boat_demo->at_island == FALSE) {
            act = aSEN_ACTION_SING_V;
        } else {
            act = aSEN_ACTION_SING_I;
        }

        aSEN_setup_think_proc(sendo, play, act);
    }
}

static void aSEN_touch_wharf_start_wait(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;

    if (boat_demo->action == aBTD_ACTION_TOUCH_WHARF_END_WAIT) {
        aSEN_setup_think_proc(sendo, play, aSEN_ACTION_TOUCH_WHARF_END_WAIT);
    }
}

static void aSEN_touch_wharf_end_wait(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;
    u8 act;

    if (boat_demo->action == aBTD_ACTION_PL_RIDE_OFF_START_WAIT) {
        if (boat_demo->at_island == FALSE) {
            act = aSEN_ACTION_ARRIVE_V;
        } else if (mPr_CheckCmpPersonalID(&Common_Get(cur_island_house_p)->ownerID, &Now_Private->player_ID) == TRUE) {
            act = aSEN_ACTION_ARRIVE_MY_ISLAND;
        } else {
            act = aSEN_ACTION_ARRIVE_OTHER_ISLAND;
        }

        mMsg_sound_unset_voice_silent(mMsg_Get_base_window_p(), TRUE);
        aSEN_setup_think_proc(sendo, play, act);
    }
}

static void aSEN_pl_ride_off_end_wait(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    static u32 destiny_pact[] = { mISL_PLAYER_ACTION_DESTINY_POPULAR, mISL_PLAYER_ACTION_DESTINY_UNPOPULAR,
                                  mISL_PLAYER_ACTION_DESTINY_BAD_LUCK, mISL_PLAYER_ACTION_DESTINY_MONEY_LUCK,
                                  mISL_PLAYER_ACTION_DESTINY_GOODS_LUCK };

    static u32 sex_pact[] = { mISL_PLAYER_ACTION_SEX_MALE, mISL_PLAYER_ACTION_SEX_FEMALE };

    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;
    u8 act;

    if (boat_demo->action == aBTD_ACTION_ANCHOR_WAIT) {
        if (boat_demo->at_island == FALSE) {
            u32 destiny = Common_Get(now_private)->destiny.type;
            u32 sex = Common_Get(now_private)->gender;

            if (mFI_CheckInIsland() == TRUE) {
                if (destiny != mPr_DESTINY_NORMAL) {
                    mISL_SetNowPlayerAction(destiny_pact[destiny - 1]);
                }

                if (sex < mPr_SEX_NUM) {
                    mISL_SetNowPlayerAction(sex_pact[sex]);
                }
            }
            act = aSEN_ACTION_OUT_OF_SERVICE_V;
        } else {
            act = aSEN_ACTION_OUT_OF_SERVICE_I;
            Common_Set(cur_island_house_p, NULL);
        }

        if (mSM_CheckOwner_unable_shutter_label(play, (u32)sendo)) {
            mSM_Set_unable_shutter_label(play, 0);
        }
        aSEN_setup_think_proc(sendo, play, act);
    }
}

static void aSEN_think_main_proc(NPC_ACTOR* actorx, GAME_PLAY* play) {
    NPC_SENDO_ACTOR* sendo = (NPC_SENDO_ACTOR*)actorx;

    if (sendo->npc_class.action.step == aNPC_ACTION_END_STEP && sendo->npc_class.action.idx != aNPC_ACT_SPECIAL) {
        aSEN_set_request_act(sendo);
    }

    (*sendo->action_proc)(sendo, play);
}

static void aSEN_think_init_proc(NPC_ACTOR* actorx, GAME_PLAY* play) {
    NPC_SENDO_ACTOR* sendo = (NPC_SENDO_ACTOR*)actorx;
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;
    u8 act;

    actorx->think.interrupt_flags = 0;
    actorx->action.act_proc = (aNPC_ACTION_PROC)&none_proc1;

    aSEN_set_request_act(sendo);
    if (boat_demo->at_island == FALSE) {
        act = aSEN_get_talk_start_wait_v_think_idx(sendo);
    } else {
        act = aSEN_ACTION_TALK_START_WAIT_I;
    }

    aSEN_setup_think_proc(sendo, play, act);
}

static void aSEN_talk_start_wait_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    sendo->npc_class.condition_info.demo_flg =
        aNPC_COND_DEMO_SKIP_LOVE_CHECK | aNPC_COND_DEMO_SKIP_FEEL_CHECK | aNPC_COND_DEMO_SKIP_FOOTSTEPS |
        aNPC_COND_DEMO_SKIP_ENTRANCE_CHECK | aNPC_COND_DEMO_SKIP_ITEM | aNPC_COND_DEMO_SKIP_FORWARD_CHECK |
        aNPC_COND_DEMO_SKIP_BGCHECK | aNPC_COND_DEMO_SKIP_MOVE_Y | aNPC_COND_DEMO_SKIP_MOVE_CIRCLE_REV |
        aNPC_COND_DEMO_SKIP_MOVE_RANGE_CHECK; // 0x3A77;
}

static void aSEN_pl_ride_on_end_wait_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;

    boat_demo->demo_act = aBTD_DEMO_PL_RIDE_ON_END;
}

static void aSEN_start_call_v_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    sendo->npc_class.talk_info.melody_inst = 0;
    sendo->npc_class.condition_info.demo_flg =
        aNPC_COND_DEMO_SKIP_LOVE_CHECK | aNPC_COND_DEMO_SKIP_FEEL_CHECK | aNPC_COND_DEMO_SKIP_FOOTSTEPS |
        aNPC_COND_DEMO_SKIP_ENTRANCE_CHECK | aNPC_COND_DEMO_SKIP_HEAD_LOOKAT | aNPC_COND_DEMO_SKIP_ITEM |
        aNPC_COND_DEMO_SKIP_FORWARD_CHECK | aNPC_COND_DEMO_SKIP_BGCHECK | aNPC_COND_DEMO_SKIP_MOVE_Y |
        aNPC_COND_DEMO_SKIP_MOVE_CIRCLE_REV | aNPC_COND_DEMO_SKIP_MOVE_RANGE_CHECK; // 0x3B77;
}

static void aSEN_sing_start_wait_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;

    boat_demo->demo_act = aBTD_DEMO_MOVE_BOAT_END;
    sendo->npc_class.talk_info.default_animation = aNPC_ANIM_WIPKOGU1;
    sendo->npc_class.draw.anim_speed_type = aNPC_ANIM_SPEED_TYPE_FREE;
}

static void aSEN_touch_wharf_end_wait_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    sendo->npc_class.head.angle_add_x = 128;
    sendo->npc_class.head.angle_add_y = 256;
}

static void aSEN_arrive_call_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    sendo->npc_class.head.angle_add_x = 512;
    sendo->npc_class.head.angle_add_y = 1024;
    sendo->npc_class.talk_info.default_animation = aNPC_ANIM_WIPWAIT1;
    sendo->npc_class.draw.anim_speed_type = aNPC_ANIM_SPEED_TYPE_LOCKED;
}

static void aSEN_pl_ride_off_end_wait_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;

    boat_demo->demo_act = aBTD_DEMO_PL_RIDE_OFF_END;
}

static void aSEN_out_of_service_v_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    sendo->npc_class.talk_info.melody_inst = 0x11A;
}

static void aSEN_out_of_service_i_init(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    sendo->npc_class.talk_info.default_animation = aNPC_ANIM_WIPWAIT2;
    mISL_RestoreIsland();
    aSEN_out_of_service_v_init(sendo, play);
    sendo->npc_class.condition_info.demo_flg =
        aNPC_COND_DEMO_SKIP_LOVE_CHECK | aNPC_COND_DEMO_SKIP_FEEL_CHECK | aNPC_COND_DEMO_SKIP_FOOTSTEPS |
        aNPC_COND_DEMO_SKIP_ENTRANCE_CHECK | aNPC_COND_DEMO_SKIP_ITEM | aNPC_COND_DEMO_SKIP_FORWARD_CHECK |
        aNPC_COND_DEMO_SKIP_BGCHECK | aNPC_COND_DEMO_SKIP_MOVE_Y | aNPC_COND_DEMO_SKIP_MOVE_CIRCLE_REV |
        aNPC_COND_DEMO_SKIP_MOVE_RANGE_CHECK; // 0x3A77;
}

static void aSEN_norm_talk_request(ACTOR*, GAME*);
static void aSEN_force_talk_request(ACTOR*, GAME*);

static void aSEN_setup_think_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play, u8 think_act) {
    static aSEN_think_setup_c dt_tbl[] = {
        { (aSEN_PROC)&none_proc1, aSEN_talk_start_wait_init, aSEN_norm_talk_request, aSEN_NORM_TALK_NO_ISLAND,
          aSEN_ACTION_NO_ISLAND, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_talk_start_wait_init, aSEN_norm_talk_request, aSEN_NORM_TALK_MY_ISLAND,
          aSEN_ACTION_MY_ISLAND, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_talk_start_wait_init, aSEN_norm_talk_request, aSEN_NORM_TALK_OTHER_ISLAND,
          aSEN_ACTION_OTHER_ISLAND, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_talk_start_wait_init, aSEN_norm_talk_request, aSEN_NORM_TALK_SELECT_ISLAND,
          aSEN_ACTION_SELECT_ISLAND, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_talk_start_wait_init, aSEN_norm_talk_request, aSEN_NORM_TALK_FIRST_MEETING,
          aSEN_ACTION_FIRST_MEETING, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_talk_start_wait_init, aSEN_norm_talk_request, aSEN_NORM_TALK_EXPLAIN_ISLAND,
          aSEN_ACTION_EXPLAIN_ISLAND, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_talk_start_wait_init, aSEN_norm_talk_request, aSEN_NORM_TALK_APRILFOOL,
          aSEN_ACTION_APRILFOOL, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_talk_start_wait_init, aSEN_norm_talk_request, aSEN_NORM_TALK_RIDE_ON_I,
          aSEN_ACTION_TALK_START_WAIT_I, aNPC_ANIM_WIPWAIT1 },
        { aSEN_pl_ride_on_end_wait, aSEN_pl_ride_on_end_wait_init, (aNPC_TALK_REQUEST_PROC)&none_proc1, 0,
          aSEN_ACTION_PL_RIDE_ON_END_WAIT, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_start_call_v_init, aSEN_force_talk_request, aSEN_FORCE_TALK_START_CALL_V,
          aSEN_ACTION_SING_START_WAIT, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_start_call_v_init, aSEN_force_talk_request, aSEN_FORCE_TALK_START_CALL_I,
          aSEN_ACTION_SING_START_WAIT, aNPC_ANIM_WIPWAIT1 },
        { aSEN_sing_start_wait, aSEN_sing_start_wait_init, (aNPC_TALK_REQUEST_PROC)&none_proc1, 0,
          aSEN_ACTION_SING_START_WAIT, aNPC_ANIM_WIPKOGU1 },
        { (aSEN_PROC)&none_proc1, (aSEN_PROC)&none_proc1, aSEN_force_talk_request, aSEN_FORCE_TALK_SING_V,
          aSEN_ACTION_TOUCH_WHARF_START_WAIT, aNPC_ANIM_WIPKOGU1 },
        { (aSEN_PROC)&none_proc1, (aSEN_PROC)&none_proc1, aSEN_force_talk_request, aSEN_FORCE_TALK_SING_I,
          aSEN_ACTION_TOUCH_WHARF_START_WAIT, aNPC_ANIM_WIPKOGU1 },
        { aSEN_touch_wharf_start_wait, (aSEN_PROC)&none_proc1, (aNPC_TALK_REQUEST_PROC)&none_proc1, 0,
          aSEN_ACTION_TOUCH_WHARF_START_WAIT, aNPC_ANIM_WIPKOGU1 },
        { aSEN_touch_wharf_end_wait, aSEN_touch_wharf_end_wait_init, (aNPC_TALK_REQUEST_PROC)&none_proc1, 0,
          aSEN_ACTION_TOUCH_WHARF_END_WAIT, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_arrive_call_init, aSEN_force_talk_request, aSEN_FORCE_TALK_ARRIVE_V,
          aSEN_ACTION_PL_RIDE_OFF_END_WAIT, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_arrive_call_init, aSEN_force_talk_request, aSEN_FORCE_TALK_ARRIVE_MY_ISLAND,
          aSEN_ACTION_PL_RIDE_OFF_END_WAIT, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_arrive_call_init, aSEN_force_talk_request, aSEN_FORCE_TALK_ARRIVE_OTHER_ISLAND,
          aSEN_ACTION_PL_RIDE_OFF_END_WAIT, aNPC_ANIM_WIPWAIT1 },
        { aSEN_pl_ride_off_end_wait, aSEN_pl_ride_off_end_wait_init, (aNPC_TALK_REQUEST_PROC)&none_proc1, 0,
          aSEN_ACTION_PL_RIDE_OFF_END_WAIT, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_out_of_service_v_init, aSEN_norm_talk_request, aSEN_NORM_TALK_OUT_OF_SERVICE_V,
          aSEN_ACTION_OUT_OF_SERVICE_V, aNPC_ANIM_WIPWAIT1 },
        { (aSEN_PROC)&none_proc1, aSEN_out_of_service_i_init, aSEN_norm_talk_request, aSEN_NORM_TALK_OUT_OF_SERVICE_I,
          aSEN_ACTION_OUT_OF_SERVICE_I, aNPC_ANIM_WIPWAIT2 },
    };

    aSEN_think_setup_c* data = &dt_tbl[think_act];

    sendo->action = think_act;
    sendo->action_proc = data->think_proc;
    sendo->npc_class.talk_info.talk_request_proc = data->talk_request_proc;
    sendo->talk_action = data->talk_act;
    sendo->next_action = data->next_action;
    (*Common_Get(clip).npc_clip->animation_init_proc)((ACTOR*)sendo, data->animation_id, FALSE);
    (*data->think_init_proc)(sendo, play);
}

static void aSEN_think_proc(NPC_ACTOR* actorx, GAME_PLAY* play, int think_act) {
    static aNPC_SUB_PROC think_proc[] = { &aSEN_think_init_proc, &aSEN_think_main_proc };

    (*think_proc[think_act])(actorx, play);
}

static void aSEN_schedule_init_proc(NPC_ACTOR* npc_actorx, GAME_PLAY* play) {
    npc_actorx->think.think_proc = &aSEN_think_proc;
    npc_actorx->condition_info.hide_request = FALSE;
    npc_actorx->palActorIgnoreTimer = -1;
    npc_actorx->talk_info.default_animation = aNPC_ANIM_WIPWAIT1;
    npc_actorx->actor_class.talk_distance = 60.0f;
    npc_actorx->collision.check_kind = aNPC_BG_CHECK_TYPE_ONLY_GROUND;
    npc_actorx->actor_class.shape_info.draw_shadow = FALSE;
    npc_actorx->actor_class.state_bitfield |= ACTOR_STATE_NO_MOVE_WHILE_CULLED;
    npc_actorx->actor_class.status_data.weight = MASSTYPE_HEAVY;
    npc_actorx->draw.chn_base_type =
        aNPC_CHN_BASE_TYPE_WORLD; // base draw position is relative to world instead of actor position
    npc_actorx->actor_class.shape_info.rotation.y = DEG2SHORT_ANGLE(80.0f);
    npc_actorx->movement.mv_angl = DEG2SHORT_ANGLE(80.0f);

    (*Common_Get(clip).npc_clip->think_proc)(npc_actorx, play, aNPC_THINK_SPECIAL, aNPC_THINK_TYPE_INIT);
}

static void aSEN_schedule_main_proc(NPC_ACTOR* npc_actorx, GAME_PLAY* play) {
    if ((*Common_Get(clip).npc_clip->think_proc)(npc_actorx, play, -1, aNPC_THINK_TYPE_CHK_INTERRUPT) == FALSE) {
        (*Common_Get(clip).npc_clip->think_proc)(npc_actorx, play, -1, aNPC_THINK_TYPE_MAIN);
    }
}

static void aSEN_schedule_proc(NPC_ACTOR* npc_actorx, GAME_PLAY* play, int sched_type) {
    static aNPC_SUB_PROC sche_proc[] = { &aSEN_schedule_init_proc, &aSEN_schedule_main_proc };

    (*sche_proc[sched_type])(npc_actorx, play);
}

static int aSEN_get_msg_no(NPC_SENDO_ACTOR* sendo, int msg_no) {
    static int msg_base_no[2][mPr_SEX_NUM] = { { 0x3091, 0x3163 }, { 0x3096, 0x3168 } };

    int msg_base;
    int msg;
    int msg_index;

    if (msg_no == 0x3091 || msg_no == 0x3096) {
        BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;

        msg_base = msg_base_no[boat_demo->at_island][Common_Get(now_private)->gender];
        msg = boat_demo->sing_msg_no;
        msg_index = msg - msg_base;

        if (msg_index < 0 || msg_index >= 5) {
            msg = msg_base;
        }
    } else if (Common_Get(now_private)->gender != mPr_SEX_MALE) {
        msg = 210 + msg_no;
    } else {
        msg = msg_no;
    }

    return msg;
}

static void aSEN_change_talk_proc(NPC_SENDO_ACTOR*, u8);

static void aSEN_setup_pl_ride_on(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    sendo->next_action = aSEN_ACTION_PL_RIDE_ON_END_WAIT;
    mDemo_Set_talk_return_demo_wait(TRUE);
    if (mSM_CheckAbleChange_unable_shutter_label(play, (u32)sendo)) {
        mSM_Set_unable_shutter_label(play, (u32)sendo);
    }
}

static void aSEN_set_island_list_str(NPC_SENDO_ACTOR* sendo) {
    typedef struct {
        u8 str[mChoice_CHOICE_STRING_LEN];
        int len;
    } aSEN_choice_c;
    aSEN_choice_c choices[PLAYER_NUM + 1];
    aSEN_choice_c* choice = choices;
    int count = sendo->island_count;
    int i;
    int len;
    for (i = 0; i < PLAYER_NUM + 1; i++) {
        mem_clear(choices[i].str, mChoice_CHOICE_STRING_LEN, CHAR_SPACE);
        choices[i].len = 0;
    }
    for (i = 0; i < count; i++) {
        mHm_hs_c* home = sendo->island_homes[i];
        len = mMl_strlen(home->island.name, mISL_ISLAND_NAME_LEN, CHAR_SPACE);
        memcpy(choice->str, home->island.name, len);
        choice->len = len;
        choice++;
    }
    mChoice_Load_ChoseStringFromRom(mChoice_Get_base_window_p(), choice->str, 41, (ACTOR*)sendo);
    choice->len = mMl_strlen(choice->str, mChoice_CHOICE_STRING_LEN, CHAR_SPACE);
    mChoice_Set_choice_data(mChoice_Get_base_window_p(), choices[0].str, choices[0].len, choices[1].str, choices[1].len,
                            choices[2].str, choices[2].len, choices[3].str, choices[3].len, choices[4].str,
                            choices[4].len, NULL, 0);
}

static void aSEN_set_sel_island_str(NPC_SENDO_ACTOR* sendo) {
    mHm_hs_c* home = sendo->island_homes[sendo->selected_island];
    mMsg_SET_FREE_STR(mMsg_FREE_STR0, home->island.name, mISL_ISLAND_NAME_LEN);
    mMsg_SET_FREE_STR(mMsg_FREE_STR1, home->ownerID.player_name, PLAYER_NAME_LEN);
}

static void aSEN_set_music_str(NPC_SENDO_ACTOR* sendo) {
    mActor_name_t music = sendo->music;
    u8 str[mIN_ITEM_NAME_LEN];
    u32 article;
    mIN_copy_name_str(str, music);
    article = mIN_get_item_article(music);
    mMsg_Set_item_str_art(mMsg_Get_base_window_p(), 0, str, sizeof(str), article);
}

static void aSEN_chk_ride_on_v_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    mMsg_Window_c* msg = mMsg_Get_base_window_p();
    if (mMsg_Check_MainNormalContinue(msg) == TRUE) {
        switch (mChoice_GET_CHOSENUM()) {
            case 0:
                Common_Set(cur_island_house_p, sendo->island_homes[0]);
                aSEN_setup_pl_ride_on(sendo, play);
                break;
            case 1:
                break;
        }
        aSEN_change_talk_proc(sendo, aSEN_TALK_END_WAIT);
    }
}

static void aSEN_select_island_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    mMsg_Window_c* msg = mMsg_Get_base_window_p();
    if (mMsg_Check_MainNormalContinue(msg) == TRUE) {
        int selected = mChoice_GET_CHOSENUM();
        int msg_no = 0x3074;
        u8 act;
        if (selected == sendo->island_count) {
            act = aSEN_TALK_END_WAIT;
        } else {
            mHm_hs_c* home;
            sendo->selected_island = selected;
            home = sendo->island_homes[selected];
            aSEN_set_sel_island_str(sendo);
            Common_Set(cur_island_house_p, home);
            if (mPr_CheckCmpPersonalID(&home->ownerID, &Now_Private->player_ID) == TRUE)
                msg_no = 0x3089;
            else
                msg_no = 0x308A;
            act = aSEN_TALK_CONFIRM_DESTINATION;
        }
        mMsg_Set_continue_msg_num(msg, aSEN_get_msg_no(sendo, msg_no));
        aSEN_change_talk_proc(sendo, act);
    }
}

static void aSEN_confirm_destination_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    mMsg_Window_c* msg = mMsg_Get_base_window_p();
    if (mMsg_Check_MainNormalContinue(msg) == TRUE) {
        u8 act = aSEN_TALK_NONE;
        switch (mChoice_GET_CHOSENUM()) {
            case 0:
                act = aSEN_TALK_END_WAIT;
                aSEN_setup_pl_ride_on(sendo, play);
                break;
            case 1:
                act = aSEN_TALK_SELECT_ISLAND;
                break;
        }
        if (act != aSEN_TALK_NONE)
            aSEN_change_talk_proc(sendo, act);
    }
}

static void aSEN_sing_end_wait_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;

    if (boat_demo->action == aBTD_ACTION_TOUCH_WHARF_END_WAIT &&
        sendo->npc_class.draw.animation_id != aNPC_ANIM_WIPWAIT1) {
        sendo->next_action = aSEN_ACTION_TOUCH_WHARF_END_WAIT;
        (*Common_Get(clip).npc_clip->animation_init_proc)((ACTOR*)sendo, aNPC_ANIM_WIPWAIT1, FALSE);
    }
}

static void aSEN_chk_ride_on_i_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    mMsg_Window_c* msg = mMsg_Get_base_window_p();
    if (mMsg_Check_MainNormalContinue(msg) == TRUE) {
        int msg_no;
        switch (mChoice_GET_CHOSENUM()) {
            case 0:
                msg_no = 0x3083;
                mNpc_SetIslandGetFtrtoRoom();
                aSEN_setup_pl_ride_on(sendo, play);
                break;
            case 1:
                msg_no = 0x3081;
                break;
        }
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
        mMsg_Set_continue_msg_num(msg, aSEN_get_msg_no(sendo, msg_no));
        aSEN_change_talk_proc(sendo, aSEN_TALK_END_WAIT);
    }
}

static void aSEN_passage_permission_check_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    mMsg_Window_c* msg = mMsg_Get_base_window_p();
    if (mMsg_Check_MainNormalContinue(msg) == TRUE) {
        switch (mChoice_GET_CHOSENUM()) {
            case 0:
                Common_Get(cur_island_house_p)->island.flags._1 = TRUE;
                break;
            case 1:
                Common_Get(cur_island_house_p)->island.flags._1 = FALSE;
                break;
        }
        aSEN_change_talk_proc(sendo, aSEN_TALK_END_WAIT);
    }
}

static void aSEN_present_start_wait_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    if ((int)mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 1) == 2)
        aSEN_change_talk_proc(sendo, aSEN_TALK_PRESENT_TRANS_TAKEOUT);
}

static void aSEN_present_trans_takeout_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    if (sendo->npc_class.left_hand.item_actor_p == NULL) {
        ACTOR* item = aHOI_CLIP->birth_proc(sendo->music, aHOI_REQUEST_PUTAWAY, aHOI_NOT_PRESENT, (ACTOR*)sendo);
        if (item != NULL) {
            aHOI_CLIP->chg_request_mode_proc((ACTOR*)sendo, aHOI_REQUEST_TRANSFER);
            sendo->npc_class.left_hand.item_actor_p = item;
            sendo->music = EMPTY_NO;
        }
    }
    if (sendo->npc_class.draw.main_animation_state == cKF_STATE_STOPPED && aHOI_CLIP->master_actor == (ACTOR*)sendo) {
        aHOI_CLIP->chg_request_mode_proc((ACTOR*)sendo, aHOI_REQUEST_TRANS_WAIT);
        aSEN_change_talk_proc(sendo, aSEN_TALK_PRESENT_TRANS_WAIT);
        NPC_CLIP->animation_init_proc((ACTOR*)sendo, aNPC_ANIM_TRANS_WAIT1, TRUE);
    }
}

static void aSEN_present_trans_wait_talk_proc(NPC_SENDO_ACTOR* sendo, GAME_PLAY* play) {
    if (aHOI_CLIP->master_actor != (ACTOR*)sendo) {
        sendo->npc_class.left_hand.item_actor_p = NULL;
        aSEN_change_talk_proc(sendo, aSEN_TALK_END_WAIT);
        NPC_CLIP->animation_init_proc((ACTOR*)sendo, sendo->npc_class.talk_info.default_animation, TRUE);
    }
}

static void aSEN_change_talk_proc(NPC_SENDO_ACTOR* sendo, u8 talk_idx) {
    static aSEN_PROC talk_proc[aSEN_TALK_NUM] = {
        (aSEN_PROC)&none_proc1,
        aSEN_chk_ride_on_v_talk_proc,
        aSEN_select_island_talk_proc,
        aSEN_confirm_destination_talk_proc,
        aSEN_sing_end_wait_talk_proc,
        aSEN_chk_ride_on_i_talk_proc,
        aSEN_passage_permission_check_talk_proc,
        aSEN_present_start_wait_talk_proc,
        aSEN_present_trans_takeout_talk_proc,
        aSEN_present_trans_wait_talk_proc,
    };
    switch (talk_idx) {
        case aSEN_TALK_CHK_RIDE_ON_V:
            sendo->selected_island = 0;
            Common_Set(cur_island_house_p, NULL);
            aSEN_set_sel_island_str(sendo);
            break;
        case aSEN_TALK_SELECT_ISLAND:
            sendo->selected_island = 0;
            Common_Set(cur_island_house_p, NULL);
            aSEN_set_island_list_str(sendo);
            break;
        case aSEN_TALK_PRESENT_TRANS_TAKEOUT:
            mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 1, 0);
            mPr_SetFreePossessionItem(Now_Private, sendo->music, mPr_ITEM_COND_NORMAL);
            mNT_present_new_music_live_version(aSEN_LIVE_MUSIC_INDEX);
            mMsg_Set_LockContinue(mMsg_Get_base_window_p());
            sAdo_OngenTrgStart(NA_SE_GASAGOSO, &sendo->npc_class.actor_class.world.position);
            NPC_CLIP->animation_init_proc((ACTOR*)sendo, aNPC_ANIM_TRANSFER1, TRUE);
            break;
    }
    sendo->talk_action = talk_idx;
    sendo->talk_proc = talk_proc[talk_idx];
}

static void aSEN_set_force_talk_info(ACTOR* actorx) {
    static aSEN_talk_request_c dt_tbl[] = {
        { 0x3077, 0, CAMERA2_PROCESS_NORMAL, 2, aSEN_TALK_END_WAIT },
        { 0x3084, 0, CAMERA2_PROCESS_NORMAL, 2, aSEN_TALK_END_WAIT },
        { 0x3091, 0, CAMERA2_PROCESS_NORMAL, 2, aSEN_TALK_SING_END_WAIT },
        { 0x3096, 0, CAMERA2_PROCESS_NORMAL, 2, aSEN_TALK_SING_END_WAIT },
        { 0x307A, 0, CAMERA2_PROCESS_NORMAL, 2, aSEN_TALK_END_WAIT },
        { 0x30BB, 0, CAMERA2_PROCESS_NORMAL, 2, aSEN_TALK_PASSAGE_PERMISSION_CHECK },
        { 0x308B, 0, CAMERA2_PROCESS_NORMAL, 2, aSEN_TALK_END_WAIT },
    };

    NPC_SENDO_ACTOR* sendo = (NPC_SENDO_ACTOR*)actorx;
    aSEN_talk_request_c* talk_request = &dt_tbl[sendo->talk_action];

    mDemo_Set_msg_num(aSEN_get_msg_no(sendo, talk_request->msg_no));
    mDemo_Set_talk_turn(talk_request->player_talk_turn);
    mDemo_Set_camera(talk_request->msg_camera_type);
    mDemo_Set_talk_change_player(FALSE);
    aSEN_set_sel_island_str(sendo);
    sendo->npc_class.talk_info.turn = talk_request->sendo_talk_turn;
    aSEN_change_talk_proc(sendo, talk_request->talk_act);
}

static void aSEN_force_talk_request(ACTOR* actorx, GAME* game) {
    mDemo_Request(mDemo_TYPE_SPEAK, actorx, &aSEN_set_force_talk_info);
}

static void aSEN_set_norm_talk_info(ACTOR* actorx) {
    static aSEN_talk_request_c dt_tbl[] = {
        { 0x3079, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_END_WAIT },
        { 0x3073, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_CHK_RIDE_ON_V },
        { 0x3075, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_CHK_RIDE_ON_V },
        { 0x3078, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_SELECT_ISLAND },
        { 0x30B9, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_END_WAIT },
        { 0x3085, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_END_WAIT },
        { 0x3073, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_END_WAIT },
        { 0x3080, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_CHK_RIDE_ON_I },
        { 0x307B, 1, CAMERA2_PROCESS_TALK, 1, aSEN_TALK_END_WAIT },
        { 0x308C, 1, CAMERA2_PROCESS_TALK, 0, aSEN_TALK_END_WAIT },
    };

    static aSEN_talk_request_c md_present_dt_tbl = { 0x0278, 1, CAMERA2_PROCESS_TALK, 0, aSEN_TALK_PRESENT_START_WAIT };
    NPC_SENDO_ACTOR* sendo = (NPC_SENDO_ACTOR*)actorx;
    aSEN_talk_request_c* talk_request = &dt_tbl[sendo->talk_action];
    int msg_no = aSEN_get_msg_no(sendo, talk_request->msg_no);
    if (sendo->talk_action == aSEN_NORM_TALK_APRILFOOL) {
        msg_no = CLIP(aprilfool_control_clip)->get_msg_num_proc(SP_NPC_SENDO, 1);
    }
    if (sendo->talk_action != aSEN_NORM_TALK_FIRST_MEETING && sendo->music != EMPTY_NO &&
        mPr_GetPossessionItemIdx(Now_Private, EMPTY_NO) != -1) {
        aSEN_set_music_str(sendo);
        talk_request = &md_present_dt_tbl;
        sendo->npc_class.condition_info.demo_flg =
            aNPC_COND_DEMO_SKIP_LOVE_CHECK | aNPC_COND_DEMO_SKIP_FEEL_CHECK | aNPC_COND_DEMO_SKIP_FOOTSTEPS |
            aNPC_COND_DEMO_SKIP_ENTRANCE_CHECK | aNPC_COND_DEMO_SKIP_FORWARD_CHECK | aNPC_COND_DEMO_SKIP_BGCHECK |
            aNPC_COND_DEMO_SKIP_MOVE_Y | aNPC_COND_DEMO_SKIP_MOVE_CIRCLE_REV | aNPC_COND_DEMO_SKIP_MOVE_RANGE_CHECK;
        msg_no = 0x0278;
    }
    mDemo_Set_msg_num(msg_no);
    mDemo_Set_talk_turn(talk_request->player_talk_turn);
    mDemo_Set_camera(talk_request->msg_camera_type);
    sendo->npc_class.talk_info.turn = talk_request->sendo_talk_turn;
    aSEN_change_talk_proc(sendo, talk_request->talk_act);
}

static void aSEN_norm_talk_request(ACTOR* actorx, GAME* game) {
    mDemo_Request(mDemo_TYPE_TALK, actorx, &aSEN_set_norm_talk_info);
}

static int aSEN_talk_init(ACTOR* actorx, GAME* game) {
    mDemo_Set_ListenAble();
    return TRUE;
}

static int aSEN_talk_end_chk(ACTOR* actorx, GAME* game) {
    NPC_SENDO_ACTOR* sendo = (NPC_SENDO_ACTOR*)actorx;
    GAME_PLAY* play = (GAME_PLAY*)game;

    int res = FALSE;

    (*sendo->talk_proc)(sendo, play);
    if (mDemo_Check(mDemo_TYPE_SPEAK, actorx) == FALSE && mDemo_Check(mDemo_TYPE_TALK, actorx) == FALSE) {
        u8 act = sendo->next_action;
        switch (act) {
            case aSEN_ACTION_FIRST_MEETING:
            case aSEN_ACTION_EXPLAIN_ISLAND:
                act = aSEN_get_talk_start_wait_v_think_idx(sendo);
                break;
        }
        aSEN_setup_think_proc(sendo, play, act);
        res = TRUE;
    }

    return res;
}

static void aSEN_set_matrix(NPC_SENDO_ACTOR* sendo) {
    BOAT_DEMO_ACTOR* boat_demo = (BOAT_DEMO_ACTOR*)sendo->npc_class.actor_class.parent_actor;

    if (boat_demo != NULL) {
        BOAT_ACTOR* boat = (BOAT_ACTOR*)boat_demo->boat_actor;

        if (boat != NULL) {
            Matrix_translate(boat->actor_class.world.position.x, boat->actor_class.world.position.y,
                             boat->actor_class.world.position.z, MTX_LOAD);
            Matrix_RotateY(boat->actor_class.shape_info.rotation.y, MTX_MULT);
            Matrix_RotateZ(boat->actor_class.shape_info.rotation.z, MTX_MULT);
            Matrix_translate(-8.0f, 20.0f, -34.0f, MTX_MULT);
            Matrix_RotateY(sendo->npc_class.actor_class.shape_info.rotation.y, MTX_MULT);
            Matrix_get(&aSEN_matrix);
            Matrix_Position_Zero(&sendo->npc_class.actor_class.world.position);

            sendo->npc_class._174 = boat->actor_class.shape_info.rotation;
        }
    }
}

static void aSEN_actor_move(ACTOR* actorx, GAME* game) {
    NPC_SENDO_ACTOR* sendo = (NPC_SENDO_ACTOR*)actorx;

    aSEN_set_matrix(sendo);

    if (sendo->npc_class.draw.anim_speed_type == aNPC_ANIM_SPEED_TYPE_FREE) {
        sAdos_GetKappaCounter(&sendo->kappa_counter);
        aSEN_set_anime_current(sendo);
    }

    (*Common_Get(clip).npc_clip->move_proc)(actorx, game);
}
