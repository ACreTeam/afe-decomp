}

static void aPG_refuse_demo_stop_wait_init(ACTOR* actorx, GAME* game) {
    NPC_POSTGIRL_ACTOR* postgirl = (NPC_POSTGIRL_ACTOR*)actorx;
    postgirl->npc_class.talk_info.default_animation = aNPC_ANIM_CONTRACT2;
    mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 0x1, 0x9);
}

static void aPG_refuse_msg_end_wait_init(ACTOR* actorx, GAME* game) {
    static int msg_no[7] = { 0x8E1, 0x8B5, 0x1BD7, 0x1BE1, 0x1BE1, 0x1BE1, 0x1BE1 };
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    NPC_POSTGIRL_ACTOR* postgirl = (NPC_POSTGIRL_ACTOR*)actorx;
    aPG_ChangeMsgData(postgirl, msg_no[(int)(postgirl->dest - aPG_RECEIVE_NO_RECIPIENT)]);
    mMsg_Unset_LockContinue(msg_p);
    postgirl->npc_class.talk_info.default_animation = -1;
}

