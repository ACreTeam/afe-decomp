}

static void aSHR_connect_check_to_send_carde(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    int status = mGcgba_ConnectEnabled();
    switch (status) {
        case GBA2_GBA_STATE_SUCCESS:
            aSHR_setup_action(shrine, play, aSHR_ACTION_SEND_CARDE_PROGRAM);
            break;
        case GBA2_GBA_STATE_TRANSMITTING:
            break;
        default:
            mMsg_Unset_LockContinue(mMsg_Get_base_window_p());
            mMsg_Set_ForceNext(mMsg_Get_base_window_p());
            mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), 0x205D);
            aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
            aSHR_EndComm(shrine, play);
            break;
    }
}

static void aSHR_send_carde_program_init(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
