static aSTC_clip_c aSTC_clip;
static u8 aSTC_eng_name[mCD_SD_FILE_NAME_SAVE_SIZE];

static int aSTC_clip_change_talk_proc(ACTOR* actorx, int talk_idx);

static void aSTC_clip_ct(void) {
    aSTC_clip.change_talk_proc = &aSTC_clip_change_talk_proc;
    CLIP(station_clip) = &aSTC_clip;
}

static void aSTC_clip_dt(void) {
    CLIP(station_clip) = NULL;
}

static void aSTC_ban_shutter(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    if (mSM_CheckAbleChange_unable_shutter_label(play, (u32)master)) {
        mSM_Set_unable_shutter_label(play, (u32)master);
    }
}

static void aSTC_release_shutter(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    if (mSM_CheckOwner_unable_shutter_label(play, (u32)master)) {
        mSM_Set_unable_shutter_label(play, 0);
    }
}

static void aSTM_set_free_str(int string_no, int str_no) {
    u8 str[mString_DEFAULT_STR_SIZE];
    mString_Load_StringFromRom(str, sizeof(str), string_no);
    mMsg_SET_FREE_STR(str_no, str, sizeof(str));
}

static void aSTM_set_slot_name(int slot_no, int str_no) {
    aSTM_set_free_str(mString_SLOT_NAME_START + slot_no, str_no);
}

static int aSTM_sdcard_select_local(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int count = master->sd_town_idx;
    int result = mSD_mura_nextname_get(aSTC_eng_name, &count);
    master->sd_town_idx = count;
    switch (result) {

        case mCD_TRANS_ERR_NONE:
            mMsg_Set_item_str(mMsg_Get_base_window_p(), mMsg_ITEM_STR0, aSTC_eng_name, sizeof(aSTC_eng_name));
            aSTM_set_slot_name(mCsd_nowdrive_get(), mMsg_FREE_STR5);
            return aSTC_SD_SELECT_TOWN;
        case mCD_TRANS_ERR_SD_NO_CARD:
        case mCD_TRANS_ERR_35:
        case mCD_TRANS_ERR_36:
        case mCD_TRANS_ERR_41:
        case mCD_TRANS_ERR_46:
        case mCD_TRANS_ERR_50:
            aSTM_set_free_str(mString_CARD_MEDIA_START + mCD_MEDIA_TYPE_SD, mMsg_FREE_STR6);
            break;
        case mCD_TRANS_ERR_SD_WRITE_PROTECTED:
            return aSTC_SD_SELECT_WRITE_PROTECTED;
        case mCD_TRANS_ERR_SD_NO_MORE_TOWNS:
            return aSTC_SD_SELECT_END;
        case mCD_TRANS_ERR_BUSY:
            return aSTC_SD_SELECT_BUSY;
        default:
            break;
    }
    return aSTC_SD_SELECT_ERROR;
}

static int aSTC_check_sdcard_whitch(NPC_STATION_MASTER_ACTOR* master) {
    s32 count;
    int result;
    if (master->check_moving_info) {
        mCD_movingInfo_set();
        result = mCD_movingInfo_get();
        master->check_moving_info = FALSE;
        switch (result) {
            case mCD_MOVING_CARD_NATIVE:
            case mCD_MOVING_CARD_FOREIGNER:
                return aSTC_SD_CHECK_CARD;
            case mCD_MOVING_SD_FOREIGNER:
                return aSTC_SD_CHECK_SINGLE_TOWN;
        }
    }
    count = 0;
    result = mSD_mura_allcount_get(&count);
    switch (result) {
        case mCD_TRANS_ERR_NONE:
            break;
        case mCD_TRANS_ERR_SD_NO_CARD:
        case mCD_TRANS_ERR_50:
            return aSTC_SD_CHECK_CARD;
        case mCD_TRANS_ERR_35:
        case mCD_TRANS_ERR_36:
        case mCD_TRANS_ERR_41:
        case mCD_TRANS_ERR_46:
            aSTM_set_slot_name(mCsd_nowdrive_get(), mMsg_FREE_STR5);
            aSTM_set_slot_name(mCsd_nowdrive_get(), mMsg_FREE_STR4);
            aSTM_set_free_str(mString_CARD_MEDIA_START + mCD_MEDIA_TYPE_SD, mMsg_FREE_STR6);
            return aSTC_SD_CHECK_ERROR;
        case mCD_TRANS_ERR_SD_WRITE_PROTECTED:
            return aSTC_SD_CHECK_WRITE_PROTECTED;
        case mCD_TRANS_ERR_BUSY:
            return aSTC_SD_CHECK_BUSY;
    }
    if (count < 1) {
        return aSTC_SD_CHECK_SINGLE_TOWN;
    } else if (count == 1) {
        return aSTC_SD_CHECK_SINGLE_TOWN;
    } else {
        aSTM_set_slot_name(mCsd_nowdrive_get(), mMsg_FREE_STR5);
        return aSTC_SD_CHECK_MULTIPLE_TOWNS;
    }
}

static void aSTC_clip_change_sound(NPC_STATION_MASTER_ACTOR* master, u16 bgm_no) {
    if (master->sound != bgm_no) {
        switch (master->sound) {
            case BGM_TRAIN_PULL_INTO_TOWN:
            case BGM_TRAIN_ARRIVAL_WAIT:
                mBGMPsComp_delete_ps_demo(master->sound, 0x168);
                break;
        }

        mBGMPsComp_make_ps_demo(bgm_no, 0x168);
        if (master->sound == BGM_FIELD_00) {
            mBGMPsComp_delete_ps_quiet();
        }

        master->sound = bgm_no;
    }
}

static int aSTM_chk_train_local(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    STRUCTURE_ACTOR* train1_p = (STRUCTURE_ACTOR*)Actor_info_fgName_search(&play->actor_info, TRAIN1, ACTOR_PART_ITEM);
    int ret;

    if (train1_p == NULL || train1_p->action > 5 || Common_Get(train_action) > 5) {
        master->train_actor_p = NULL;
        Common_Set(train_coming_flag, 4);
        ret = 0;
    } else {
        master->train_actor_p = (ACTOR*)train1_p;
        ret = 1;
        Common_Set(train_coming_flag, 2);
        aSTC_clip_change_sound(master, BGM_TRAIN_ARRIVAL_WAIT);
    }

    return ret;
}

static void aSTM_sdcardproc(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    static u8 next_talk_act[] = { aSTM_TALK_CHK_TRAIN2_TALK, aSTM_TALK_BEFORE_SAVE_TALK, aSTM_TALK_END_WAIT,
                                  aSTM_TALK_END_WAIT,        aSTM_TALK_CHK_REPAIRID,     aSTM_TALK_CHK_REPAIRID,
                                  aSTM_TALK_END_WAIT,        aSTM_TALK_END_WAIT,         aSTM_TALK_END_WAIT,
                                  aSTM_TALK_END_WAIT,        aSTM_TALK_END_WAIT,         aSTM_TALK_SDCARD_SELECT_2,
                                  aSTM_TALK_END_WAIT,        aSTM_TALK_END_WAIT,         aSTM_TALK_END_WAIT,
                                  aSTM_TALK_END_WAIT,        aSTM_TALK_END_WAIT };
    static int msg_no[] = { MSG_2379, MSG_2389, MSG_2380,  MSG_2381, MSG_2382, MSG_2390, MSG_2374, MSG_2375, MSG_2402,
                            MSG_2410, MSG_2411, MSG_13756, MSG_2413, MSG_2414, MSG_2376, MSG_2403, MSG_2409 };
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    mCD_sd_card_info_c info;
    int talk_idx = -1;
    int result;
    info.chan = 0;
    info.exist = 0;
    result = mCD_SD_CheckStation_bg(&info);
    master->station_check_res = result;
    switch (result) {

        case mCD_TRANS_ERR_NONE_NEXTLAND:
            talk_idx = aSTM_chk_train_local(master, play);
            break;
        case mCD_TRANS_ERR_CORRUPT:
            talk_idx = 2;
            break;
        case mCD_TRANS_ERR_IOERROR:
            talk_idx = 16;
            break;
        case mCD_TRANS_ERR_REPAIR:
            master->station_err = result;
            talk_idx = 4;
            break;
        case mCD_TRANS_ERR_BROKEN_WRONGENCODING:
            master->station_err = result;
            talk_idx = 5;
            break;
        case mCD_TRANS_ERR_TOWN_INVALID:
        case mCD_TRANS_ERR_NO_TOWN_DATA:
        case mCD_TRANS_ERR_42:
            talk_idx = 6;
            break;
        case mCD_TRANS_ERR_OTHER_TOWN:
        case mCD_TRANS_ERR_NOCARD:
        case mCD_TRANS_ERR_GENERIC:
            talk_idx = 7;
            break;
        case mCD_TRANS_ERR_WRONG_LAND:
        case mCD_TRANS_ERR_TRAVEL_DATA_MISSING:
            talk_idx = 8;
            break;
        case mCD_TRANS_ERR_NOT_MEMCARD:
            talk_idx = 9;
            break;
        case mCD_TRANS_ERR_WRONGDEVICE:
            talk_idx = 10;
            break;
        case mCD_TRANS_ERR_50:
            talk_idx = 10;
            break;
        case mCD_TRANS_ERR_26:
            talk_idx = 11;
            break;
        case mCD_TRANS_ERR_31:
            talk_idx = 12;
            break;
        case mCD_TRANS_ERR_30:
            talk_idx = 13;
            break;
        case mCD_TRANS_ERR_NO_SPACE:
            talk_idx = 14;
            break;
        case mCD_TRANS_ERR_SD_NO_CARD:
        case mCD_TRANS_ERR_35:
            if (Common_Get(player_no) == mPr_FOREIGNER) {
                talk_idx = 7;
            } else {
                talk_idx = 15;
            }
            break;
        case mCD_TRANS_ERR_36:
        case mCD_TRANS_ERR_41:
        case mCD_TRANS_ERR_46:
            talk_idx = 15;
            break;
        case mCD_TRANS_ERR_DAMAGED:
            talk_idx = 16;
            break;
        case mCD_TRANS_ERR_BUSY:
            break;
        default:
            talk_idx = 7;
            break;
    }
    if (talk_idx != -1) {
        if (info.chan == mCD_SLOT_A || info.chan == mCD_SLOT_B) {
            aSTM_set_slot_name(info.chan == mCD_SLOT_A, mMsg_FREE_STR3);
            aSTM_set_slot_name(info.chan, mMsg_FREE_STR5);
            aSTM_set_slot_name(info.chan, mMsg_FREE_STR4);
            aSTM_set_free_str(mString_CARD_MEDIA_START + info.exist, mMsg_FREE_STR6);
        }
        master->chan = info.chan;
        mMsg_UNSET_LOCKCONTINUE();
        aSTC_release_shutter(master, play);
        mMsg_Set_continue_msg_num(msg_p, msg_no[talk_idx]);
        aSTC_clip_change_talk_proc((ACTOR*)master, next_talk_act[talk_idx]);
    }
}

static void aSTM_cardproc(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    // clang-format off
    static u8 next_talk_act[] = {
        aSTM_TALK_CHK_TRAIN2_TALK,
        aSTM_TALK_BEFORE_SAVE_TALK,
        aSTM_TALK_CHK_TRAIN2_TALK,
        aSTM_TALK_BEFORE_SAVE_TALK,
        aSTM_TALK_CHK_OVER_SAVE_TALK,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_CHK_REPAIRID,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_END_WAIT,
        aSTM_TALK_CHK_REPAIRID,
        aSTM_TALK_END_WAIT,
    };
    // clang-format on

    // clang-format off
    static u8 msg_no[] = {
        8,
        12,
        8,
        18,
        27,
        9,
        10,
        19,
        3,
        4,
        31,
        5,
        36,
        30,
        37,
        38,
        39,
        11,
        40,
    };
    // clang-format on

    ACTOR* actorx = (ACTOR*)master;
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    int talk_idx = -1;
    s32 chan;
    int card_ret = mCD_CheckStation_bg(&chan);

    master->station_check_res = card_ret;
    switch (card_ret) {
        case mCD_TRANS_ERR_NONE:
            talk_idx = aSTM_chk_train_local(master, play);
            break;
        case mCD_TRANS_ERR_NONE_NEXTLAND:
            talk_idx = 2 + aSTM_chk_train_local(master, play);
            break;
        case mCD_TRANS_ERR_TRAVEL_DATA_EXISTS:
            talk_idx = 4;
            break;
        case mCD_TRANS_ERR_CORRUPT:
            talk_idx = 5;
            break;
        case mCD_TRANS_ERR_IOERROR:
            talk_idx = 15;
            break;
        case mCD_TRANS_ERR_BROKEN_WRONGENCODING:
            master->station_err = card_ret;
            talk_idx = 7;
            break;
        case mCD_TRANS_ERR_NO_TOWN_DATA:
            talk_idx = 8;
            break;
        case mCD_TRANS_ERR_NOCARD:
            talk_idx = 9;
            break;
        case mCD_TRANS_ERR_TRAVEL_DATA_MISSING:
            talk_idx = 10;
            break;
        case mCD_TRANS_ERR_NO_SPACE:
            talk_idx = 11;
            break;
        case mCD_TRANS_ERR_WRONG_LAND:
            talk_idx = 12;
            break;
        case mCD_TRANS_ERR_LAND_EXIST:
            talk_idx = 13;
            break;
        case mCD_TRANS_ERR_NO_FILES:
            talk_idx = 14;
            break;
        case mCD_TRANS_ERR_DAMAGED:
            talk_idx = 15;
            break;
        case mCD_TRANS_ERR_NOT_MEMCARD:
            talk_idx = 16;
            break;
        case mCD_TRANS_ERR_REPAIR:
            master->station_err = card_ret;
            talk_idx = 17;
            break;
        case mCD_TRANS_ERR_WRONGDEVICE:
            talk_idx = 18;
            break;
        default:
            talk_idx = 9;
            break;
        case mCD_TRANS_ERR_BUSY:
            break;
    }

    if (talk_idx != -1) {
        if (chan == 0 || chan == 1) {
            aSTM_set_slot_name(chan == 0, mMsg_FREE_STR3);
            aSTM_set_slot_name(chan, mMsg_FREE_STR5);
            aSTM_set_slot_name(chan, mMsg_FREE_STR4);
        }

        master->chan = chan;
        mMsg_UNSET_LOCKCONTINUE();
        aSTC_release_shutter(master, play);
        mMsg_Set_continue_msg_num(msg_p, MSG_2371 + msg_no[talk_idx]);
        aSTC_clip_change_talk_proc(actorx, next_talk_act[talk_idx]);
    }
}

static void aSTM_sdcard_whitch(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    int result = aSTC_check_sdcard_whitch(master);
    switch (result) {
        case aSTC_SD_CHECK_CARD:
            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_CARDPROC);
            aSTM_set_free_str(mString_CARD_MEDIA_START + mCD_MEDIA_TYPE_CARD, mMsg_FREE_STR6);
            master->sd_town_idx = -1;
            break;
        case aSTC_SD_CHECK_SINGLE_TOWN:
            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARDPROC);
            master->sd_town_idx = 0;
            break;
        case aSTC_SD_CHECK_MULTIPLE_TOWNS:
            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARD_SELECT_0);
            master->sd_town_idx = 0;
            mMsg_Unset_LockContinue(msg_p);
            aSTC_release_shutter(master, play);
            mMsg_Set_continue_msg_num(msg_p, MSG_13752);
            break;
        case aSTC_SD_CHECK_WRITE_PROTECTED:
            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
            mMsg_Unset_LockContinue(msg_p);
            aSTC_release_shutter(master, play);
            mMsg_Set_continue_msg_num(msg_p, MSG_2412);
            break;
        case aSTC_SD_CHECK_ERROR:
            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
            mMsg_Unset_LockContinue(msg_p);
            aSTC_release_shutter(master, play);
            mMsg_Set_continue_msg_num(msg_p, MSG_2374);
            break;
    }
}

static void aSTM_sdcard_select_0(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int order = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    if (order != 0) {
        switch (order) {
            case 1:
                mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 2);
                mMsg_SET_LOCKCONTINUE();
                aSTC_ban_shutter(master, play);
                break;
            case 2:
                switch (aSTM_sdcard_select_local(master, play)) {
                    case aSTC_SD_SELECT_TOWN:
                        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARD_SELECT_1);
                        break;
                    case aSTC_SD_SELECT_WRITE_PROTECTED:
                        mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), MSG_2412);
                        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                        break;
                    case aSTC_SD_SELECT_BUSY:
                        return;
                    default:
                        mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), MSG_2403);
                        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                        break;
                }
                mMsg_Unset_LockContinue(msg_p);
                aSTC_release_shutter(master, play);
                mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
                break;
        }
    }
}

static void aSTM_sdcard_select_1(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int order = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    if (order == 2) {
        switch (aSTM_sdcard_select_local(master, play)) {
            case aSTC_SD_SELECT_TOWN:
                mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), MSG_13753);
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARD_SELECT_1);
                break;
            case aSTC_SD_SELECT_END:
                mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), MSG_13755);
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARD_SELECT_2);
                break;
            case aSTC_SD_SELECT_WRITE_PROTECTED:
                mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), MSG_2412);
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                break;
            case aSTC_SD_SELECT_BUSY:
                return;
            default:
                mMsg_Set_continue_msg_num(mMsg_Get_base_window_p(), MSG_2403);
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                break;
        }
        mMsg_Unset_LockContinue(msg_p);
        aSTC_release_shutter(master, play);
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
    } else if (order != 0) {
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARDPROC);
                mMsg_SET_LOCKCONTINUE();
                aSTC_ban_shutter(master, play);
                break;
            case mChoice_CHOICE1:
                mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 2);
                mMsg_SET_LOCKCONTINUE();
                aSTC_ban_shutter(master, play);
                break;
            case mChoice_CHOICE2:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                break;
        }
    }
}

static void aSTM_sdcard_select_2(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int order = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    if (order != 0) {
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARD_WHITCH);
                mMsg_SET_LOCKCONTINUE();
                aSTC_ban_shutter(master, play);
                master->check_moving_info = TRUE;
                master->sd_town_idx = 0;
                break;
            case mChoice_CHOICE1:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                break;
        }
        mMsg_Set_ForceNext(mMsg_Get_base_window_p());
    }
}

static void aSTM_give_live_md_talk(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int order = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 1);
    if (order == 2) {
        mActor_name_t item = mNT_get_new_music_live_version(aSTM_LIVE_MUSIC_INDEX);
        mDemo_Set_OrderValue(mDemo_ORDER_NPC1, 0, item);
        mDemo_Set_OrderValue(mDemo_ORDER_NPC1, 1, 7);
        mDemo_Set_OrderValue(mDemo_ORDER_NPC1, 2, 0);
        mPr_SetFreePossessionItem(Now_Private, item, mPr_ITEM_COND_NORMAL);
        mNT_present_new_music_live_version(aSTM_LIVE_MUSIC_INDEX);
        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
    }
}

static void aSTM_chk_leave_talk(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    if (mMsg_CHECK_MAINNORMALCONTINUE() == TRUE) {
        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_CHK_LEAVE_TALK2);
                break;
            case mChoice_CHOICE1:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                break;
        }
    }
}

static void aSTM_chk_leave_talk2(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    if (mMsg_CHECK_MAINNORMALCONTINUE() == TRUE) {
        mMsg_SET_LOCKCONTINUE();
        aSTC_ban_shutter(master, play);
        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARD_WHITCH);
        master->check_moving_info = TRUE;
    }
}

static void aSTM_repairid_after(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int order = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();

    if (order != 0 && mMsg_Check_MainNormalContinue(msg_p) == TRUE) {
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
        mMsg_SET_LOCKCONTINUE();
        aSTC_ban_shutter(master, play);
        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SDCARD_WHITCH);
        master->check_moving_info = TRUE;
    }
}

static void aSTM_chk_train_talk(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    static u8 next_talk_act[] = { aSTM_TALK_CHK_TRAIN2_TALK, aSTM_TALK_BEFORE_SAVE_TALK };
    static u8 msg_no[] = { 8, 12 };
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    int idx;

    if (mMsg_Check_MainNormalContinue(msg_p) == TRUE) {
        idx = aSTM_chk_train_local(master, play);
        mMsg_Set_continue_msg_num(msg_p, MSG_2371 + msg_no[idx]);
        aSTC_clip_change_talk_proc((ACTOR*)master, next_talk_act[idx]);
    }
}

static void aSTM_chk_train2_talk(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();

    if (mMsg_Check_MainNormalContinue(msg_p) == TRUE) {
        if (master->station_check_res == mCD_TRANS_ERR_NONE_NEXTLAND) {
            mMsg_Set_continue_msg_num(msg_p, MSG_2389);
        } else {
            mMsg_Set_continue_msg_num(msg_p, MSG_2383);
        }

        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_BEFORE_SAVE_TALK);
        aSTC_clip_change_sound(master, BGM_TRAIN_ARRIVAL_WAIT);
    }
}

static void aSTM_before_save_talk(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int order = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();

    if (order != 0) {
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SAVE_TALK);
        mMsg_Set_LockContinue(msg_p);
        aSTC_ban_shutter(master, play);
        Actor_info_save_actor(play);
    }
}

static void aSTM_save_talk(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    static int msg_no[] = { MSG_2384, MSG_2404 };
    static u8 next_think_idx[] = { aSTM_THINK_MOVE_TURN_BF, aSTM_THINK_MAKE_TRAIN_BF };
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    int idx;
    int res;
    mCD_sd_card_info_c info;
    int next_msg_no;

    info.exist = 0;
    info.chan = 0;
    if (master->sd_town_idx == -1) {
        if (master->station_check_res == mCD_TRANS_ERR_NONE_NEXTLAND) {
            res = mCD_SaveStation_NextLand_bg(&info.chan);
        } else {
            res = mCD_SaveStation_Passport_bg(&info.chan);
        }
    } else {
        res = mCD_SD_SaveStation_NextLand_bg(&info);
    }

    switch (res) {
        case mCD_TRANS_ERR_NONE:
            mMsg_Unset_LockContinue(msg_p);
            aSTC_release_shutter(master, play);
            idx = master->train_actor_p == NULL;
            mMsg_Set_continue_msg_num(msg_p, msg_no[idx]);
            master->next_think_idx = next_think_idx[idx];
            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SAVE_TALK_END);
            mEv_SetGateway();
            mDemo_Set_talk_return_demo_wait(TRUE);
            break;
        case mCD_TRANS_ERR_BUSY:
            break;
        default:
            if (info.chan == mCD_SLOT_A || info.chan == mCD_SLOT_B) {
                aSTM_set_slot_name(info.chan == mCD_SLOT_A, mMsg_FREE_STR3);
                aSTM_set_slot_name(info.chan, mMsg_FREE_STR5);
                aSTM_set_slot_name(info.chan, mMsg_FREE_STR4);
                aSTM_set_free_str(mString_CARD_MEDIA_START + info.exist, mMsg_FREE_STR6);
            }

            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_SAVE_ERROR);
            switch (res) {
                case mCD_TRANS_ERR_BROKEN_WRONGENCODING:
                    next_msg_no = MSG_2390;
                    aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_CHK_REPAIRID);
                    master->station_err = res;
                    break;
                case mCD_TRANS_ERR_REPAIR:
                    next_msg_no = MSG_2382;
                    aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_CHK_REPAIRID);
                    master->station_err = res;
                    break;
                case mCD_TRANS_ERR_CORRUPT:
                    next_msg_no = MSG_2380;
                    break;

                case mCD_TRANS_ERR_IOERROR:
                    next_msg_no = MSG_2409;
                    break;
                case mCD_TRANS_ERR_NO_TOWN_DATA:
                    if (Common_Get(player_no) == mPr_FOREIGNER) {
                        next_msg_no = MSG_2414;
                    } else {
                        next_msg_no = MSG_2374;
                    }
                    break;
                case mCD_TRANS_ERR_OTHER_TOWN:
                case mCD_TRANS_ERR_NOCARD:
                case mCD_TRANS_ERR_GENERIC:
                    if (res == mCD_TRANS_ERR_NOCARD && info.exist == mCD_MEDIA_TYPE_SD) {
                        next_msg_no = MSG_2403;
                    } else {
                        next_msg_no = MSG_2375;
                    }
                    if (res == mCD_TRANS_ERR_NOCARD && mCD_movingInfo_get() == mCD_MOVING_SD_FOREIGNER) {
                        next_msg_no = MSG_2414;
                    }
                    break;
                case mCD_TRANS_ERR_TRAVEL_DATA_MISSING:
                    next_msg_no = MSG_2402;
                    break;
                case mCD_TRANS_ERR_NO_SPACE:
                    next_msg_no = MSG_2376;
                    break;
                case mCD_TRANS_ERR_WRONG_LAND:
                    next_msg_no = MSG_2407;
                    break;
                case mCD_TRANS_ERR_LAND_EXIST:
                    next_msg_no = MSG_2401;
                    break;
                case mCD_TRANS_ERR_NO_FILES:
                    next_msg_no = MSG_2408;
                    break;
                case mCD_TRANS_ERR_DAMAGED:
                    next_msg_no = MSG_2409;
                    break;
                case mCD_TRANS_ERR_NOT_MEMCARD:
                    next_msg_no = MSG_2410;
                    break;
                case mCD_TRANS_ERR_WRONGDEVICE:
                    next_msg_no = MSG_2411;
                    break;
                case mCD_TRANS_ERR_31:
                    next_msg_no = MSG_2413;
                    break;
                case mCD_TRANS_ERR_30:
                    next_msg_no = MSG_2414;
                    break;
                case mCD_TRANS_ERR_46:
                    next_msg_no = MSG_2411;
                    break;
                case mCD_TRANS_ERR_SD_NO_CARD:
                case mCD_TRANS_ERR_35:
                case mCD_TRANS_ERR_36:
                case mCD_TRANS_ERR_42:
                    if (Common_Get(player_no) == mPr_FOREIGNER) {
                        next_msg_no = MSG_2375;
                    } else {
                        next_msg_no = MSG_2374;
                    }
                    break;
                case mCD_TRANS_ERR_50:
                    next_msg_no = MSG_2411;
                    break;
                case mCD_TRANS_ERR_TOWN_INVALID:
                case mCD_TRANS_ERR_41:
                    next_msg_no = MSG_2403;
                    break;
                case mCD_TRANS_ERR_SD_WRITE_PROTECTED:
                    next_msg_no = MSG_2412;
                    break;
                case mCD_TRANS_ERR_51:
                    next_msg_no = MSG_2415;
                    break;
                default:
                    next_msg_no = MSG_2403;
                    break;
            }

            mMsg_Unset_LockContinue(msg_p);
            aSTC_release_shutter(master, play);
            mMsg_Set_continue_msg_num(msg_p, next_msg_no);

            if (Common_Get(player_no) < PLAYER_NUM) {
                master->next_think_idx = aSTM_THINK_TALK_WAIT;
            } else {
                master->next_think_idx = aSTM_THINK_FOREIGNER_TALK_WAIT;
            }

            mMsg_Set_ForceNext(msg_p);
            mBGMPsComp_make_ps_quiet(0x168);
            mBGMPsComp_delete_ps_demo(master->sound, 0x168);
            master->sound = BGM_SILENCE;
            if (master->train_actor_p == NULL) {
                Common_Set(train_coming_flag, 0);
            }
            break;
    }
}

static void aSTM_save_error(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    ACTOR* actorx = (ACTOR*)master;

    if (!mDemo_Check(mDemo_TYPE_SPEAK, actorx) && !mDemo_Check(mDemo_TYPE_TALK, actorx)) {
        switch (master->happening_sound) {
            case BGM_INTRO_ARRIVE:
                mBGMPsComp_delete_ps_happening(BGM_INTRO_ARRIVE, 0x168);
                mBGMPsComp_make_ps_happening(BGM_INTRO_NEW_TOWN, 0x168);
                master->happening_sound = BGM_INTRO_NEW_TOWN;
                break;
        }

        mBGMPsComp_delete_ps_quiet();
    }
}

static void aSTM_chk_over_save_talk(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    if (mMsg_CHECK_MAINNORMALCONTINUE() == TRUE) {
        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0:
                master->next_think_idx = aSTM_THINK_TALK_WAIT;
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                break;
            case mChoice_CHOICE1:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_CHK_TRAIN_TALK);
                aSTC_clip_change_sound(master, BGM_TRAIN_ARRIVAL_WAIT);
                break;
        }
    }
}

static void aSTM_save_talk_end(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    ACTOR* actorx = (ACTOR*)master;

    if (master->sound != BGM_FIELD_00 && master->next_think_idx == aSTM_THINK_MAKE_TRAIN_BF) {
        if (mMsg_CHECK_MAINDISAPPEAR()) {
            if (master->sound != BGM_SILENCE) {
                mBGMPsComp_delete_ps_demo(master->sound, 0x168);
            }

            mBGMPsComp_make_ps_quiet(0x21C);
            master->sound = BGM_FIELD_00;
        }
    }

    if (!mDemo_Check(mDemo_TYPE_TALK, actorx)) {
        if (mPlib_get_player_actor_main_index((GAME*)play) != mPlayer_INDEX_DEMO_WAIT) {
            mPlib_request_main_demo_wait_type1((GAME*)play, FALSE, NULL);
        } else {
            aSTC_clip_change_talk_proc(actorx, aSTM_TALK_END_WAIT);
        }
    }
}

static void aSTM_sayonara(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    if (mMsg_CHECK_MAINDISAPPEAR()) {
        mBGMPsComp_scene_mode(7);
        aSTC_clip_change_sound(master, BGM_TRAIN_BOARD);
    }
}

static void aSTM_chk_repairid(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int order = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();

    if (order != 0 && mMsg_Check_MainNormalContinue(msg_p) == TRUE) {
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);

        switch (mChoice_GET_CHOSENUM()) {
            case mChoice_CHOICE0:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_REPAIRID_BF);
                break;
            case mChoice_CHOICE1:
                aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
                break;
        }
    }
}

static void aSTM_repairid_bf(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    int order = mDemo_Get_OrderValue(mDemo_ORDER_NPC0, 9);
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();

    if (order != 0 && mMsg_Check_MainNormalContinue(msg_p) == TRUE) {
        mDemo_Set_OrderValue(mDemo_ORDER_NPC0, 9, 0);
        mMsg_Set_LockContinue(msg_p);
        aSTC_ban_shutter(master, play);
        aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_REPAIRID);
    }
}

static void aSTM_repairid(NPC_STATION_MASTER_ACTOR* master, GAME_PLAY* play) {
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    int res = mCD_card_format_bg(master->chan);

    switch (res) {
        case mCD_RESULT_SUCCESS:
            mMsg_Unset_LockContinue(msg_p);
            aSTC_release_shutter(master, play);
            if (master->station_err == mCD_TRANS_ERR_BROKEN_WRONGENCODING) {
                mMsg_Set_continue_msg_num(msg_p, MSG_2394);
            } else {
                mMsg_Set_continue_msg_num(msg_p, MSG_2388);
            }

            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_REPAIRID_AFTER);
            break;
        case mCD_RESULT_ERROR:
            mMsg_Unset_LockContinue(msg_p);
            aSTC_release_shutter(master, play);
            if (master->station_err == mCD_TRANS_ERR_BROKEN_WRONGENCODING) {
                mMsg_Set_continue_msg_num(msg_p, MSG_2392);
            } else {
                mMsg_Set_continue_msg_num(msg_p, MSG_2386);
            }

            aSTC_clip_change_talk_proc((ACTOR*)master, aSTM_TALK_END_WAIT);
            break;
    }
}

static int aSTC_clip_change_talk_proc(ACTOR* actorx, int talk_act) {
    // clang-format off
    static aSTM_TALK_PROC proc[] = {
        &aSTM_chk_leave_talk,
        &aSTM_chk_leave_talk2,
        &aSTM_sayonara,
        &aSTM_chk_train_talk,
        &aSTM_chk_train2_talk,
        &aSTM_before_save_talk,
        &aSTM_save_talk,
        &aSTM_chk_over_save_talk,
        &aSTM_save_talk_end,
        &aSTM_save_error,
        &aSTM_chk_repairid,
        &aSTM_repairid_bf,
        &aSTM_repairid,
        &aSTM_repairid_after,
        &aSTM_cardproc,
        &aSTM_sdcardproc,
        &aSTM_sdcard_whitch,
        &aSTM_sdcard_select_0,
        &aSTM_sdcard_select_1,
        &aSTM_sdcard_select_2,
        &aSTM_give_live_md_talk,
        (aSTM_TALK_PROC)&none_proc1,
    };
    // clang-format on

    NPC_STATION_MASTER_ACTOR* master = (NPC_STATION_MASTER_ACTOR*)actorx;

    master->talk_proc = proc[talk_act];
    return TRUE;
}
