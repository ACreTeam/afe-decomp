static void aSHR_upload(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    int status = mGcgba_Recv(aSHR_trans_work_30k, 0x48);
    mMsg_Set_LockContinue(mMsg_Get_base_window_p());
    switch (status) {
        case GBA2_GBA_STATE_TRANSMITTING:
