    mMsg_Get_base_window_p();
    choice = mChoice_Get_ChoseNum(mChoice_Get_base_window_p());
    if (mMsg_Check_MainNormalContinue(mMsg_Get_base_window_p()) && choice != -1) {
        switch (choice) {
            case 0:
                aSHR_setup_action(shrine, play, aSHR_ACTION_READ_CARDE_S);
                break;
            case 1:
                mMsg_Set_ForceNext(mMsg_Get_base_window_p());
                aSHR_setup_action(shrine, play, aSHR_ACTION_SEND_CARDE_PROGRAM_S);
                break;
            default:
                aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
                break;
        }
    }
}

