static void aNTT_roll_weather(NPC_TOTAKEKE_ACTOR* totakeke) {
    aWeather_Clip_c* weather;
    weather = CLIP(weather_clip);
    if (weather != NULL) {
        if (totakeke->roll4_count == FRAMERATE_SELECT(5600, 4665)) {
            weather->change_weather(weather->actor, mEnv_WEATHER_SAKURA, mEnv_WEATHER_INTENSITY_HEAVY);
        } else if (totakeke->roll4_count == FRAMERATE_SELECT(1310, 1090)) {
            weather->change_weather(weather->actor, mEnv_WEATHER_RAIN, mEnv_WEATHER_INTENSITY_HEAVY);
        } else if (totakeke->roll4_count == FRAMERATE_SELECT(2450, 2041)) {
            weather->change_weather(weather->actor, mEnv_WEATHER_LEAVES, mEnv_WEATHER_INTENSITY_HEAVY);
        } else if (totakeke->roll4_count == FRAMERATE_SELECT(3910, 3258)) {
            weather->change_weather(weather->actor, mEnv_WEATHER_SNOW, mEnv_WEATHER_INTENSITY_HEAVY);
        } else if (totakeke->roll4_count == FRAMERATE_SELECT(1870, 1558)) {
            weather->change_weather(weather->actor, mEnv_WEATHER_RAIN, mEnv_WEATHER_INTENSITY_NONE);
        } else if (totakeke->roll4_count == FRAMERATE_SELECT(2970, 2550)) {
            weather->change_weather(weather->actor, mEnv_WEATHER_LEAVES, mEnv_WEATHER_INTENSITY_NONE);
        } else if (totakeke->roll4_count == FRAMERATE_SELECT(4800, 3975)) {
            weather->change_weather(weather->actor, mEnv_WEATHER_SNOW, mEnv_WEATHER_INTENSITY_NONE);
        } else if (totakeke->roll4_count == FRAMERATE_SELECT(6350, 5165)) {
            weather->change_weather(weather->actor, mEnv_WEATHER_SAKURA, mEnv_WEATHER_INTENSITY_NONE);
        }
    }
}

static void aNTT_wait(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    ACTOR* actorx = (ACTOR*)totakeke;
    aNTT_event_save_c* save = (aNTT_event_save_c*)mEv_get_save_area(mEv_EVENT_KK_SLIDER, 10);
    u8 think = 0xFF;
    if (ABS(actorx->player_angle_y) > 4000) {
        think = aNTT_THINK_NONE;
    } else if (actorx->npc_id == SP_NPC_TOTAKEKE_BIRTHDAY) {
        think = aNTT_THINK_WAIT;
    } else if ((Now_Private->state_flags & mPr_FLAG_TOTAKEKE_INTRODUCTION) == 0) {
        think = aNTT_THINK_ROLL1;
    } else if (aNTT_bitcheck_func(save->bitfield, aNTT_FLAG_HELLO) == 0) {
        think = aNTT_THINK_WAIT;
    } else {
        think = aNTT_THINK_ROLL;
    }
    if (think != 0xFF && totakeke->think != think) {
        aNTT_setup_think_proc(totakeke, play, think);
    }
}

static void aNTT_roll(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    staffroll_light_proc_start(play);
    if (totakeke->roll_count > 0) {
        totakeke->roll_count -= 1;
    } else {
        aNTT_setup_think_proc(totakeke, play, ++totakeke->think);
    }
    CLIP(mikanbox_clip)->roll_proc(totakeke, play);
}

static void aNTT_roll1(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    u16 bgm = CLIP(mikanbox_clip)->bgm_no_proc(totakeke);
    if (bgm == mBGMPsComp_execute_bgm_num_get()) {
        if (CLIP(mikanbox_clip) != NULL) {
            CLIP(mikanbox_clip)->sound_proc(totakeke, play, aNTT_THINK_ROLL2);
            if (totakeke->show_timer >= 800) {
                aNTT_setup_think_proc(totakeke, play, ++totakeke->think);
                return;
            }
            if (CLIP(mikanbox_clip)->section_chk_proc(STAFFROLL_PART_MAIN)) {
                aNTT_setup_think_proc(totakeke, play, ++totakeke->think);
            }
        }
        CLIP(mikanbox_clip)->roll_proc(totakeke, play);
    }
}

static void aNTT_roll2(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    if (CLIP(mikanbox_clip) != NULL) {
        CLIP(mikanbox_clip)->sound_proc(totakeke, play, aNTT_THINK_ROLL2);
    }
    staffroll_light_proc_start(play);
    totakeke->roll2_count += 1;
    totakeke->roll4_count += 1;
    CLIP(mikanbox_clip)->roll_proc(totakeke, play);
    aNTT_roll_weather(totakeke);
    if (totakeke->roll2_count > 475) {
        totakeke->_9a2 += 1;
        if (totakeke->_9a2 >= 15) {
            aNTT_setup_think_proc(totakeke, play, aNTT_THINK_8);
            Common_Get(event_common).exist_flags1 &= ~aNTT_FLAG_SP_ROLL_DRAW;
            Common_Get(event_common).exist_flags1 |= aNTT_FLAG_SP_ROLL_END;
        } else {
            aNTT_setup_think_proc(totakeke, play, aNTT_THINK_7);
        }
    }
}

static void aNTT_roll4(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    aNTT_event_save_c* save = (aNTT_event_save_c*)mEv_get_save_area(mEv_EVENT_KK_SLIDER, 0xa);
    totakeke->roll4_count += 1;
    CLIP(mikanbox_clip)->roll_proc(totakeke, play);
    if (totakeke->roll4_count >= FRAMERATE_SELECT(7560, 6330) ||
        totakeke->roll4_count <= FRAMERATE_SELECT(7280, 6070)) {
        save->copyright_alpha = 0;
    } else if (totakeke->roll4_count > FRAMERATE_SELECT(7480, 6250)) {
        save->copyright_alpha = 3.1875f * (FRAMERATE_SELECT(7560, 6330) - totakeke->roll4_count);
    } else if (totakeke->roll4_count < FRAMERATE_SELECT(7360, 6150)) {
        save->copyright_alpha = 3.1875f * (totakeke->roll4_count - FRAMERATE_SELECT(7280, 6070));
    } else {
        save->copyright_alpha = 255;
    }

    if (CLIP(mikanbox_clip) != NULL) {
        CLIP(mikanbox_clip)->sound_proc(totakeke, play, aNTT_THINK_ROLL2);
        if (totakeke->roll4_count > 8360) {
            save->copyright_alpha = 0;
            aNTT_setup_think_proc(totakeke, play, aNTT_THINK_9);
        } else if (CLIP(mikanbox_clip)->section_chk_proc(STAFFROLL_PART_FINISH) &&
                   totakeke->roll4_count > FRAMERATE_SELECT(7560, 6330)) {
            save->copyright_alpha = 0;
            aNTT_setup_think_proc(totakeke, play, aNTT_THINK_9);
        }
    }
}

static void aNTT_roll_end(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    totakeke->npc_class.draw.main_animation.keyframe.frame_control.current_frame = totakeke->_9a0;
    if (totakeke->_9aa != 0) {
        CLIP(mikanbox_clip)->head_up_proc((ACTOR*)totakeke);
    }
    if (staffroll_light_proc_end(play)) {
        aNTT_setup_think_proc(totakeke, play, totakeke->post_roll_think);
        totakeke->npc_class.condition_info.demo_flg = FALSE;
    }
}

static void aNNT_bdmsg_com(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    if (CLIP(mikanbox_clip) != NULL) {
        CLIP(mikanbox_clip)->sound_proc(totakeke, play, aNTT_THINK_BIRTHDAY_ROLL);
    }
    staffroll_light_proc_start(play);
}

static void aNTT_bdmsg_1(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    u16 bgm = CLIP(mikanbox_clip)->bgm_no_proc(totakeke);
    if (bgm == mBGMPsComp_execute_bgm_num_get() && CLIP(mikanbox_clip) != NULL) {
        CLIP(mikanbox_clip)->sound_proc(totakeke, play, aNTT_THINK_BIRTHDAY_ROLL);
        if (CLIP(mikanbox_clip)->birthday_section_proc(0) == aNTT_BIRTHDAY_INTRO) {
            Na_SetBirthdayLoopCount(totakeke->birthday_msg_num);
            aNTT_setup_think_proc(totakeke, play, ++totakeke->think);
        }
    }
}

static void aNTT_bdmsg_2(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    int section;
    aNNT_bdmsg_com(totakeke, play);
    section = CLIP(mikanbox_clip)->birthday_section_proc(0);
    if (section != totakeke->birthday_section) {
        switch (section) {
            case aNTT_BIRTHDAY_HEADER_IN:
            case aNTT_BIRTHDAY_BODY_IN:
            case aNTT_BIRTHDAY_FOOTER_IN:
            case aNTT_BIRTHDAY_FINISH:
                Common_Get(event_common).exist_flags1 &=
                    ~(aNTT_FLAG_BIRTHDAY_HEADER | aNTT_FLAG_BIRTHDAY_BODY | aNTT_FLAG_BIRTHDAY_FOOTER);
                break;
        }
        switch (section) {
            case aNTT_BIRTHDAY_HEADER_IN:
                aNTT_bdmsg_h_start(totakeke, play);
                break;
            case aNTT_BIRTHDAY_BODY_IN:
                aNTT_bdmsg_b_start(totakeke, play);
                break;
            case aNTT_BIRTHDAY_FOOTER_IN:
                aNTT_bdmsg_f_start(totakeke, play);
                break;
            case aNTT_BIRTHDAY_NEXT_MSG:
                totakeke->birthday_msg_idx++;
                break;
            case aNTT_BIRTHDAY_FINISH:
                Common_Get(event_common).exist_flags1 |= aNTT_FLAG_SP_ROLL_END;
                break;
            case aNTT_BIRTHDAY_END:
                aNTT_setup_think_proc(totakeke, play, ++totakeke->think);
                break;
        }
        totakeke->birthday_section = section;
    }
    switch (totakeke->birthday_section) {
        case aNTT_BIRTHDAY_HEADER_IN:
        case aNTT_BIRTHDAY_BODY_IN:
        case aNTT_BIRTHDAY_FOOTER_IN:
            if (totakeke->roll2_count < 40) {
                totakeke->roll2_count++;
            }
            break;
        case aNTT_BIRTHDAY_HEADER_OUT:
        case aNTT_BIRTHDAY_BODY_OUT:
        case aNTT_BIRTHDAY_FOOTER_OUT:
            if (totakeke->roll2_count > 0) {
                totakeke->roll2_count--;
            }
            break;
        case aNTT_BIRTHDAY_NEXT_MSG:
            if (totakeke->roll2_count > 0 && totakeke->birthday_msg_idx != totakeke->birthday_msg_num) {
                totakeke->roll2_count--;
            }
            break;
    }
}

static aNTT_PROC proc_table[aNTT_PROC_NUM] = {
    (aNTT_PROC)none_proc1, aNTT_wait,    aNTT_roll,   aNTT_roll1, aNTT_roll2, aNTT_roll4,
    aNTT_roll_end,         aNTT_bdmsg_1, aNTT_bdmsg_2
};

static void aNTT_think_main_proc(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    proc_table[totakeke->think_proc_id](totakeke, play);
}

static void aNTT_think_init_proc(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    totakeke->npc_class.actor_class.status_data.weight = 0xff;
    totakeke->npc_class.condition_info.hide_request = FALSE;
    aNTT_setup_think_proc(totakeke, play, aNTT_THINK_NONE);
}

static aNTT_think_data_c dt_tbl[aNTT_THINK_NUM] = {
    { aNTT_PROC_WAIT, aNTT_INIT_NONE, aNTT_REQUEST_NORMAL, aNTT_TALK_NONE, aNTT_THINK_NONE },
    { aNTT_PROC_WAIT, aNTT_INIT_NONE, aNTT_REQUEST_NORMAL, aNTT_TALK_SELECT0, aNTT_THINK_WAIT },
    { aNTT_PROC_WAIT, aNTT_INIT_NONE, aNTT_REQUEST_NORMAL, aNTT_TALK_SELECT1, aNTT_THINK_ROLL },
    { aNTT_PROC_WAIT, aNTT_INIT_NONE, aNTT_REQUEST_NORMAL, aNTT_TALK_STOP_PLAYER, aNTT_THINK_ROLL1 },
    { aNTT_PROC_ROLL, aNTT_INIT_ROLL, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_ROLL2 },
    { aNTT_PROC_ROLL1, aNTT_INIT_ROLL1, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_ROLL4 },
    { aNTT_PROC_ROLL2, aNTT_INIT_ROLL2, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_ROLL_END },
    { aNTT_PROC_ROLL2, aNTT_INIT_ROLL3, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_7 },
    { aNTT_PROC_ROLL4, aNTT_INIT_NONE, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_8 },
    { aNTT_PROC_ROLL_END, aNTT_INIT_ROLL_END, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_9 },
    { aNTT_PROC_ROLL, aNTT_INIT_ROLL, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_BIRTHDAY_ROLL },
    { aNTT_PROC_BIRTHDAY_START, aNTT_INIT_BIRTHDAY, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_BIRTHDAY_START },
    { aNTT_PROC_BIRTHDAY_MSG, aNTT_INIT_NONE, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_BIRTHDAY_MSG },
    { aNTT_PROC_ROLL_END, aNTT_INIT_ROLL_END, aNTT_REQUEST_NONE, aNTT_TALK_NONE, aNTT_THINK_BIRTHDAY_END },
    { aNTT_PROC_NONE, aNTT_INIT_CALL, aNTT_REQUEST_FORCE, aNTT_TALK_NONE, aNTT_THINK_NONE },
    { aNTT_PROC_NONE, aNTT_INIT_CALL, aNTT_REQUEST_FORCE, aNTT_TALK_SELECT0, aNTT_THINK_NONE },
    { aNTT_PROC_NONE, aNTT_INIT_CALL, aNTT_REQUEST_FORCE, aNTT_TALK_SELECT1, aNTT_THINK_NONE },
    { aNTT_PROC_NONE, aNTT_INIT_CALL, aNTT_REQUEST_FORCE, 3, aNTT_THINK_NONE },
    { aNTT_PROC_NONE, aNTT_INIT_CALL, aNTT_REQUEST_FORCE, 4, aNTT_THINK_NONE }
};

static void aNTT_setup_think_proc(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play, u8 think_id) {
    static aNPC_TALK_REQUEST_PROC talk_request_table[aNTT_REQUEST_NUM] = { (aNPC_TALK_REQUEST_PROC)none_proc1,
                                                                           aNTT_norm_talk_request,
                                                                           aNTT_force_talk_request };
    aNTT_think_data_c* think = &dt_tbl[think_id];
    if (totakeke->think != think_id) {
        totakeke->_9a1 = TRUE;
    }
    totakeke->think = think_id;
    totakeke->think_proc_id = think->think_proc_id;
    totakeke->npc_class.talk_info.talk_request_proc = talk_request_table[think->next_talk];
    totakeke->talk = think->talk;
    totakeke->pre_roll_think = think->pre_roll_think;

    if (CLIP(mikanbox_clip) != NULL) {
        CLIP(mikanbox_clip)->think_init_proc(totakeke, play, think->think_init_idx);
    }
}

static void aNTT_think_proc(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play, int think_id) {
    switch (think_id) {
        case 0x0:
            aNTT_think_init_proc(totakeke, play);
            break;
        case 0x1:
            aNTT_think_main_proc(totakeke, play);
            break;
    }
}

static void aNTT_schedule_init_proc(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    totakeke->npc_class.think.think_proc = (aNPC_THINK_PROC)aNTT_think_proc;
    CLIP(npc_clip)->think_proc((NPC_ACTOR*)totakeke, play, aNPC_THINK_SPECIAL, 0);
}

static void aNTT_schedule_main_proc(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play) {
    if (CLIP(npc_clip)->think_proc((NPC_ACTOR*)totakeke, play, -1, 1) == FALSE) {
        CLIP(npc_clip)->think_proc((NPC_ACTOR*)totakeke, play, -1, 2);
    }
}

static void aNTT_schedule_proc(NPC_TOTAKEKE_ACTOR* totakeke, GAME_PLAY* play, int schedule_id) {
    switch (schedule_id) {
        case 0:
            aNTT_schedule_init_proc(totakeke, play);
            break;
        case 1:
            aNTT_schedule_main_proc(totakeke, play);
            break;
    }
}
