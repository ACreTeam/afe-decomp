static void aSHR_actor_move(ACTOR* actorx, GAME* game);

static int aSHR_npc_dist_to_add_npc_index(u16 distinguish) {
    int i;

    for (i = 0; i < mAN_ANIMAL_NUM; i++) {
        if ((Common_Get(add_npc_info).compress_info_table >> i) & 1) {
            if (Common_Get(add_npc_info).info[i].id == distinguish) {
                return i;
            }
        }
    }
    return -1;
}

static u16 aSHR_npc_dist_to_npc_no(u16 distinguish) {
    if (ITEM_NAME_GET_TYPE(distinguish) == NAME_TYPE_NPC) {
        return (u16)distinguish;
    } else {
        int idx = aSHR_npc_dist_to_add_npc_index(distinguish);
        return idx != -1 ? (mActor_name_t)(NPC_ADD_START + idx) : (mActor_name_t)EMPTY_NO;
    }
}

static int aSHR_npc_dist_to_npcID_in_village(u16 distinguish) {
    mActor_name_t npc = aSHR_npc_dist_to_npc_no(distinguish);
    int i;

    for (i = 0; i < ANIMAL_NUM_MAX; i++) {
        if (!mNpc_CheckFreeAnimalPersonalID(&Save_Get(animals[i]).id) && Save_Get(animals[i]).id.npc_id == npc) {
            return i;
        }
    }
    return -1;
}

static int aSHR_npc_dist_to_exist_npc_in_village(u16 distinguish) {
    return aSHR_npc_dist_to_npcID_in_village(distinguish) != -1;
}

static int aSHR_npc_dist_table_to_exist_npc_num(u16* distinguish, int count) {
    int i;
    int num = 0;

    for (i = 0; i < count; i++) {
        if (aSHR_npc_dist_to_exist_npc_in_village(distinguish[i])) {
            num++;
        }
    }
    return num;
}

static int aSHR_npc_dist_to_exist_name(u16 distinguish) {
    if (ITEM_NAME_GET_TYPE(distinguish) == NAME_TYPE_NPC && !IS_NPC_ADD_NPC(distinguish)) {
        if (mNpc_GetNpcWorldNameP(distinguish) != NULL) {
            return TRUE;
        }
    } else if (aSHR_npc_dist_to_npc_no(distinguish) != EMPTY_NO) {
        return TRUE;
    }
    return FALSE;
}

static int aSHR_influence_friendship(PersonalID_c* pid, u16 distinguish, s8 friendship) {
    mActor_name_t npc = aSHR_npc_dist_to_npc_no(distinguish);

    if (npc != EMPTY_NO) {
        return mNpc_AddFriendshipPlayer(pid, npc, friendship);
    }
    return FALSE;
}

static int aSHR_fg_to_village_npc_type(mActor_name_t npc) {
    if (IS_NPC_ADD_NPC(npc)) {
        int idx = npc - NPC_ADD_START;
        if (Common_Get(add_npc_info).info[idx].is_islander == TRUE) {
            return FALSE;
        }
    } else if (ITEM_NAME_GET_TYPE(npc) == NAME_TYPE_NPC) {
        int permission = mNpc_GetDefGrowPermissionName(npc);
        if (permission == mNpc_GROW_ISLANDER || permission == -1) {
            return FALSE;
        }
    }
    return TRUE;
}

static int aSHR_read_data_to_village_npc_type(u16 info, AnimalInfo_c* data) {
    mActor_name_t npc = mEA_animal_carde_info_to_npc_no(info);

    if (npc == EMPTY_NO) {
        return data->is_islander == FALSE;
    }
    return aSHR_fg_to_village_npc_type(npc);
}

static int aSHR_npc_dist_to_looks(u16 distinguish) {
    if (ITEM_NAME_GET_TYPE(distinguish) == NAME_TYPE_NPC) {
        return mNpc_GetLooks(distinguish);
    } else {
        int idx = aSHR_npc_dist_to_add_npc_index(distinguish);
        if (idx != -1) {
            return Common_Get(add_npc_info).info[idx].looks;
        }
    }
    return mNpc_LOOKS_GIRL;
}

static mActor_name_t aSHR_present_table[18] = {
    FTR_OZA_APPLE_BOX_SOUTH, FTR_MUT_SCARECROW_SOUTH,    FTR_OZA_DOKI_SOUTH,       FTR_OZA_BATHTUB_SOUTH,
    FTR_MUT_BASCKET_SOUTH,   FTR_OZA_COFFIN_SOUTH,       FTR_OZA_ORANGE_BOX_SOUTH, FTR_MUT_TOBIDASI_SOUTH,
    FTR_OZA_HYDRANT_SOUTH,   FTR_OZA_IDOL_SOUTH,         FTR_OZA_PINBALL_SOUTH,    FTR_OZA_DRUM_SOUTH,
    FTR_OZA_FRAGILE_SOUTH,   FTR_OZA_WOOD_HORSE_SOUTH,   FTR_OZA_SHOWER_SOUTH,     FTR_MUT_WHEEL_SOUTH,
    FTR_OZA_DART_SOUTH,      FTR_MUT_PRINCESS_BED_SOUTH,
};
static int aSHR_looks_letter_start[6] = { 0x4E8, 0x4FA, 0x50C, 0x51E, 0x530, 0x542 };

static int aSHR_make_mail_data(Mail_c* mail, PersonalID_c* pid, int npc_idx, u8 looks, u8* letter_npc, u8* topic_npc,
                               u8* else_npc, int game_type, int result) {
    static u8 tmp_header[MAIL_HEADER2_LEN];
    static u8 tmp_footer[MAIL_FOOTER2_LEN];
    u8 str0[mMsg_FREE_STRING_LEN];
    u8 str1[mMsg_FREE_STRING_LEN];
    u8 item_name[mIN_ITEM_NAME_LEN];
    int header_back_start;
    int present_idx = result + game_type * 6;
    int letter_no = present_idx + aSHR_looks_letter_start[looks];
    mActor_name_t present = aSHR_present_table[present_idx];

    mMl_clear_mail(mail);
    mFont_CopyStrings(mail->header.sender.personalID.player_name, letter_npc, ANIMAL_NAME_LEN);
    mHandbill_Set_free_str(mMsg_FREE_STR0, pid->player_name, PLAYER_NAME_LEN);
    mHandbill_Set_free_str(mMsg_FREE_STR1, letter_npc, ANIMAL_NAME_LEN);
    mHandbill_Set_free_str(mMsg_FREE_STR2, topic_npc, ANIMAL_NAME_LEN);
    mString_Load_StringFromRom(str0, sizeof(str0), RANDOM(32) + 0x3F4);
    mHandbill_Set_free_str(mMsg_FREE_STR3, str0, sizeof(str0));
    mString_Load_StringFromRom(str1, sizeof(str1), RANDOM(32) + 0x3B4);
    mHandbill_Set_free_str(mMsg_FREE_STR4, str1, sizeof(str1));
    mIN_copy_name_str(item_name, present);
    mHandbill_Set_free_str(mMsg_FREE_STR5, item_name, sizeof(item_name));
    mHandbill_Set_free_str(mMsg_FREE_STR6, else_npc, ANIMAL_NAME_LEN);
    mHandbill_Load_HandbillFromRom2(tmp_header, sizeof(tmp_header), &header_back_start, tmp_footer, sizeof(tmp_footer),
                                    mail->content.text.split.body, letter_no);
    bcopy(tmp_header, mail->content.text.split.header, MAIL_HEADER_LEN);
    bcopy(tmp_footer, mail->content.text.split.footer, MAIL_FOOTER_LEN);
    mail->content.font = mMl_FONT_RECV;
    mail->content.header_back_start = header_back_start;
    mail->content.mail_type = mMl_TYPE_MAIL;
    mail->content.paper_type = mNpc_GetPaperType();
    mail->header.recipient.personalID = *pid;
    mail->header.recipient.type = mMl_NAME_TYPE_PLAYER;
    mMl_set_mail_name_npcinfo(&mail->header.sender, &Save_Get(animals[npc_idx]).id);
    mail->header.sender.type = mMl_NAME_TYPE_NPC;
    mail->present = present;
    return TRUE;
}

static int aSHR_send_mail_to_down_load_player(PersonalID_c* pid, int npc_idx, u8 looks, u8* letter_npc, u8* topic_npc,
                                              u8* else_npc, int game_type, int result) {
    static Mail_c mail;
    int i;

    for (i = 0; i < PLAYER_NUM; i++) {
        if (mPr_CheckCmpPersonalID(pid, &Save_Get(private_data[i]).player_ID) &&
            aSHR_make_mail_data(&mail, pid, npc_idx, looks, letter_npc, topic_npc, else_npc, game_type, result) &&
            mPO_get_keep_mail_sum() < mPO_MAIL_STORAGE_SIZE && mPO_receipt_proc(&mail, mPO_SENDTYPE_MAIL)) {
            return TRUE;
        }
    }
    return FALSE;
}

static void aSHR_influence_updata(u8* data) {
    static u8 letter_npc_str[ANIMAL_NAME_LEN];
    static u8 topic_npc_str[ANIMAL_NAME_LEN];
    static u8 else_npc_str[ANIMAL_NAME_LEN];
    u16 distinguish[5];
    PersonalID_c pid;
    s8 friendship[5];
    int game_type = mAP_receive_data_to_agb_game_type(data);
    int result = mAP_receive_data_to_agb_game_result(data);
    int already;
    int topic;
    int count;
    int exist;
    int i;
    int npc_idx;
    int letter_idx;
    int else_idx;

    mAP_receive_data_to_agb_friendship(&friendship[0], &friendship[1], &friendship[2], &friendship[3], &friendship[4],
                                       data);
    mAP_receive_data_to_agb_distinguish(&distinguish[0], &distinguish[1], &distinguish[2], &distinguish[3],
                                        &distinguish[4], data);
    mAP_receive_data_to_agb_personalID(&pid, data);
    already = mAP_receive_data_to_update_already(data);
    topic = mAP_receive_data_to_topic_npc_receive_index(data);
    if (mLd_CheckCmpLand(pid.land_name, pid.land_id, Now_Private->player_ID.land_name,
                         Now_Private->player_ID.land_id)) {
        count = mAP_agb_game_type_to_npc_num(game_type);
        if (already == FALSE) {
            for (i = 0; i < count; i++) {
                aSHR_influence_friendship(&pid, distinguish[i], friendship[i]);
            }
            exist = aSHR_npc_dist_table_to_exist_npc_num(distinguish, count);
            if (exist > 0) {
                int eligible;
                int selected;
                int n;
                int i;
                letter_idx = -1;
                else_idx = -1;
                eligible = aSHR_npc_dist_to_exist_npc_in_village(distinguish[topic]) ? exist - 1 : exist;
                selected = RANDOM(eligible);
                n = 0;
                for (i = 0; i < count; i++) {
                    if (i != topic && aSHR_npc_dist_to_exist_npc_in_village(distinguish[i])) {
                        if (n == selected) {
                            letter_idx = i;
                            break;
                        }
                        n++;
                    }
                }
                npc_idx = aSHR_npc_dist_to_npcID_in_village(distinguish[letter_idx]);
                if (npc_idx != -1) {
                    selected = RANDOM(count - 2);
                    n = 0;
                    for (i = 0; i < count; i++) {
                        if (aSHR_npc_dist_to_exist_name(distinguish[i]) && i != letter_idx && i != topic) {
                            if (n == selected) {
                                else_idx = i;
                                break;
                            }
                            n++;
                        }
                    }
                    if (letter_idx != -1 && else_idx != -1) {
                        u8 looks = aSHR_npc_dist_to_looks(distinguish[letter_idx]);
                        mAP_receive_data_to_agb_npc_name(letter_npc_str, data, letter_idx);
                        mAP_receive_data_to_agb_npc_name(topic_npc_str, data, topic);
                        mAP_receive_data_to_agb_npc_name(else_npc_str, data, else_idx);
                        aSHR_send_mail_to_down_load_player(&pid, npc_idx, looks, letter_npc_str, topic_npc_str,
                                                           else_npc_str, game_type, result);
                    }
                }
            }
        }
    }
}

static u8 aSHR_carde_receive[0x800];
static u8 aSHR_decode_work_30k[30 * 1024];
static u8 aSHR_trans_work_30k[30 * 1024];
static u32 aSHR_agb_game_data_size;

static void aSHR_request_reserve_add_npc(void) {
    mActor_name_t npc = mEA_animal_carde_info_to_npc_no((aSHR_carde_receive[0] << 8) | aSHR_carde_receive[1]);
    mAN_set_new_comer_compress_data(aSHR_carde_receive + 0x95, &Now_Private->player_ID, npc);
}

static int aSHR_exist_my_island(void) {
    u8 idx = mHS_get_arrange_idx(Common_Get(player_no));
    u32 size = Save_Get(homes[idx & 3]).size_info.next_size;
    return size >= mHm_HOMESIZE_ISLAND;
}

static int aSHR_check_my_island_npc_exist(void) {
    if (aSHR_exist_my_island() == TRUE) {
        int idx = mHS_get_arrange_idx(Common_Get(player_no));
        if (!mNpc_CheckFreeAnimalPersonalID(&Save_Get(homes[idx & 3]).island.animal.id)) {
            return TRUE;
        }
    }
    return FALSE;
}

static int aSHR_check_npc_live_in_this_world(u16 info, AnimalInfo_c* data) {
    mActor_name_t npc = mEA_animal_carde_info_to_npc_no(info);

    if (npc != EMPTY_NO) {
        if (mNpc_SearchAnimalinfo(Save_Get(animals), npc, ANIMAL_NUM_MAX) != -1) {
            return TRUE;
        }
        if (mNpc_SearchIslandAnimalinfo(npc, 0xFF) != -1) {
            return TRUE;
        }
    } else if (aSHR_npc_dist_to_add_npc_index(data->id) != -1) {
        return TRUE;
    }
    return FALSE;
}

static void aSHR_SetTransSE(SHRINE_ACTOR* shrine) {
    shrine->structure_class.arg1_f = 1.0f;
}

static void aSHR_SetTransSE_move(SHRINE_ACTOR* shrine) {
    if (shrine->structure_class.arg1_f == 1.0f) {
        if (shrine->structure_class.arg2_f == 0.0f) {
            sAdo_SysLevStart(0x47);
        }
    } else if (shrine->structure_class.arg2_f == 1.0f) {
        sAdo_SysLevStop(0x47);
    }
    shrine->structure_class.arg2_f = shrine->structure_class.arg1_f;
    shrine->structure_class.arg1_f = 0.0f;
}

/* @unused static void aSHR_OngenTrgStart(SHRINE_ACTOR*, int?) */

static void aSHR_set_bgOffset(ACTOR* actorx, int table_idx) {
    static mCoBG_OffsetTable_c height_table_ct[4][2] = {
        {
            { mCoBG_ATTRIBUTE_NONE, 1, 1, 1, 1, 1, 0 }, // X
            { mCoBG_ATTRIBUTE_NONE, 1, 1, 1, 1, 1, 0 }, // Z
        },
        {
            { mCoBG_ATTRIBUTE_NONE, 2, 2, 1, 1, 4, 0 },
            { mCoBG_ATTRIBUTE_NONE, 2, 4, 1, 1, 2, 0 },
        },
        {
            { mCoBG_ATTRIBUTE_NONE, 11, 11, 11, 11, 11, 0 },
            { mCoBG_ATTRIBUTE_NONE, 11, 11, 11, 11, 11, 0 },
        },
        {
            { mCoBG_ATTRIBUTE_NONE, 11, 11, 11, 11, 11, 0 },
            { mCoBG_ATTRIBUTE_NONE, 11, 11, 11, 11, 11, 0 },
        },
    };

    static mCoBG_OffsetTable_c* height_table[] = { (mCoBG_OffsetTable_c*)height_table_ct,
                                                   (mCoBG_OffsetTable_c*)height_table_ct };

    static f32 addX[2] = { -20.0f, 20.0f };
    static f32 addZ[4] = { 20.0f, -20.0f, -60.0f, -100.0f };

    mCoBG_OffsetTable_c* height_table_p = (mCoBG_OffsetTable_c*)height_table[table_idx];
    int i;

    for (i = 0; i < 4; i++) {
        xyz_t pos;

        pos.z = actorx->home.position.z + addZ[i];
        pos.x = actorx->home.position.x + addX[0];
        mCoBG_SetPluss5PointOffset_file(pos, height_table_p[0], "ac_shrine_move_PP.c_inc", 1438);

        pos.x = actorx->home.position.x + addX[1];
        mCoBG_SetPluss5PointOffset_file(pos, height_table_p[1], "ac_shrine_move_PP.c_inc", 1442);

        height_table_p += 2;
    }
}

static int aSHR_talk_check(ACTOR* actorx, GAME_PLAY* play) {
    PLAYER_ACTOR* player = GET_PLAYER_ACTOR(play);
    SHRINE_ACTOR* shrine = (SHRINE_ACTOR*)actorx;
    int res = FALSE;

    if (aSHR_GET_CLIP()->hem_flag == TRUE) {
        return FALSE;
    }

    if (shrine->structure_class.arg2 == 0 && mDemo_Get_talk_actor() == NULL && player != NULL) {
        s16 player_angle_y = search_position_angleY(&actorx->world.position, &player->actor_class.world.position);

        if (ABS(player_angle_y - actorx->shape_info.rotation.y) < DEG2SHORT_ANGLE(22.5f)) {
            res = TRUE;
        }
    }

    return res;
}

static void aSHR_set_talk_info(ACTOR* actorx) {
    rgba_t window_color;

    mDemo_Set_msg_num(MSG_4388);
    mDemo_Set_camera(CAMERA2_PROCESS_NORMAL);
    mDemo_Set_talk_display_name(FALSE);
    mDemo_Set_ListenAble();

    window_color.r = 205;
    window_color.g = 80;
    window_color.b = 40;
    window_color.a = 255;
    mDemo_Set_talk_window_color(&window_color);
}

static int aSHR_ctrl_light() {
    int res = FALSE;

    if (Common_Get(time.now_sec) < (6 * mTM_SECONDS_IN_HOUR) ||
        Common_Get(time.now_sec) >= (18 * mTM_SECONDS_IN_HOUR)) {
        res = TRUE;
    }

    return res;
}

static void aSHR_init_no_proc(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
}

static void aSHR_wait(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    if (mDemo_Check(mDemo_TYPE_TALK, (ACTOR*)shrine) == TRUE) {
        mDemo_Set_ListenAble();
        aSHR_setup_action(shrine, play, aSHR_ACTION_TALK);
    } else if (aSHR_talk_check((ACTOR*)shrine, play)) {
        mDemo_Request(mDemo_TYPE_TALK, (ACTOR*)shrine, &aSHR_set_talk_info);
    }
}

static int aSHR_possession_have_Qitem_limit_out(void) {
    int i;
    for (i = 0; i < mPr_POCKETS_SLOT_COUNT; i++) {
        if (mSM_check_item_for_shrine1(i) && mSM_check_item_for_shrine2(i)) {
            return TRUE;
        }
    }
    return FALSE;
}

static int aSHR_possession_have_Qitem_limit_in(void) {
    int i;
    for (i = 0; i < mPr_POCKETS_SLOT_COUNT; i++) {
        if (mSM_check_item_for_shrine1(i)) {
            return TRUE;
        }
    }
    return FALSE;
}

static void aSHR_talk(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    int msg_no = 0x1128;
    int action;
    int condition;
    int field_rank;
    int bx;
    int bz;
    int good_field;
    u8 acre_str[66];

    if (mMsg_Check_MainNormalContinue(msg_p)) {
        switch (mChoice_Get_ChoseNum(mChoice_Get_base_window_p())) {
            case mChoice_CHOICE3:
                mMsg_Set_continue_msg_num(msg_p, 0x1130);
                action = aSHR_ACTION_CONNECT_CHECK_TO_CHECK_EXIST;
                break;

            case mChoice_CHOICE1:
                if (!mLd_PlayerManKindCheck()) {
                    if (Save_Get(add_npc).new_comer.new_comer_set == TRUE) {
                        action = aSHR_ACTION_TALK_END;
                        mMsg_Set_continue_msg_num(msg_p, 0x2057);
                    } else {
                        action = aSHR_ACTION_QUESTION_CARDE;
                        mMsg_Set_continue_msg_num(msg_p, 0x2058);
                    }
                } else {
                    action = aSHR_ACTION_TALK_END;
                    mMsg_Set_continue_msg_num(msg_p, 0x2056);
                }
                break;
            case mChoice_CHOICE0: /* How are things? */
            {
                condition = mFAs_GetFieldRank_Condition(&field_rank, &bx, &bz);
                good_field = mFAs_CheckGoodField();

                if (field_rank == mFAs_FIELDRANK_SIX &&               /* Current field rank is 'perfect' */
                    good_field &&                                     /* Perfect town status achieved for long enough */
                    mSC_trophy_get(mSC_TROPHY_GOLDEN_AXE) == FALSE && /* Haven't already obtained the golden axe */
                    mLd_PlayerManKindCheck() == FALSE &&              /* Must be from this town */
                    mPr_GetPossessionItemIdx(Now_Private, EMPTY_NO) >= 0 && /* Must have a free inventory slot */
                    mEv_CheckFirstJob() == FALSE &&                         /* Can't be doing the part-time job */
                    condition != mFAs_CONDITION_DUST_OVER                   /* No trash */
                ) {
                    msg_no = 0x2C50;
                    action = aSHR_ACTION_MAKE_HEM;
                } else if (condition != mFAs_CONDITION_NO_CASE) {
                    if (condition == mFAs_CONDITION_DUST_OVER) {
                        msg_no = 0x2C4F;
                    } else if (condition == mFAs_CONDITION_TREE_LESS) {
                        msg_no = 0x2C45;
                    } else if (condition == mFAs_CONDITION_TREE_OVER) {
                        msg_no = 0x2C46;
                    } else {
                        msg_no = 0x2C47;
                    }

                    mFont_UnintToString(acre_str, sizeof(acre_str), bx, sizeof(acre_str), TRUE, FALSE, FALSE);
                    mMsg_Set_free_str(msg_p, mMsg_FREE_STR1, acre_str, sizeof(acre_str));
                    mFont_UnintToString(acre_str, sizeof(acre_str), bz, sizeof(acre_str), TRUE, FALSE, FALSE);
                    mMsg_Set_free_str(msg_p, mMsg_FREE_STR0, acre_str, sizeof(acre_str));
                    action = aSHR_ACTION_TALK_END;
                } else if (field_rank == mFAs_FIELDRANK_SIX) {
                    msg_no = 0x2C48;
                    action = aSHR_ACTION_TALK_END;
                } else {
                    msg_no = 0x2C49;
                    action = aSHR_ACTION_TALK_END;
                }

                mMsg_Set_continue_msg_num(msg_p, msg_no);
                break;
            }

            case mChoice_CHOICE2: /* Apologize */
            {
                if (aSHR_possession_have_Qitem_limit_out()) {
                    shrine->structure_class.arg0 = 0;
                    action = aSHR_ACTION_TALK_GOMEN;
                } else if (aSHR_possession_have_Qitem_limit_in()) {
                    msg_no = 0x1127;
                    action = aSHR_ACTION_TALK_END;
                } else {
                    msg_no = 0x1133;
                    action = aSHR_ACTION_TALK_END;
                }

                mMsg_Set_continue_msg_num(msg_p, msg_no);
                break;
            }

            default: /* 'What's this?', 'Nothing...' */
            {
                action = aSHR_ACTION_TALK_END;
                break;
            }
        }

        if (action != -1) {
            aSHR_setup_action(shrine, play, action);
        }
    }
}

static void aSHR_talk_gomen(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    mMsg_Window_c* msg_p = mMsg_Get_base_window_p();
    Submenu* submenu = &play->submenu;
    int msg_no = -1;

    /* TODO: enums for whatever this is */
    switch (shrine->structure_class.arg0) {
        case 0: {
            if (mMsg_Check_MainNormalContinue(msg_p) == TRUE) {
                mMsg_request_main_disappear_wait_type1(msg_p);
                shrine->structure_class.arg0 = 1;
            }
            return;
        }

        case 1: {
            if (mMsg_Check_main_wait(msg_p) == TRUE) {
                mSM_open_submenu(submenu, mSM_OVL_INVENTORY, mSM_IV_OPEN_SHRINE, 0);
                shrine->structure_class.arg0 = 2;
            }
            return;
        }

        case 2: {
            u8 item_name[mIN_ITEM_NAME_LEN];
            Submenu_Item_c* sm_item;
            if (submenu->open_flag) {
                return;
            }

            sm_item = submenu->item_p;
            if (sm_item->item == EMPTY_NO) {
                mMsg_request_main_forceoff();
            } else if (mQst_CheckNpcExistbyItemIdx(sm_item->slot_no, mQst_CHECK_NPC_RECEIPIENT)) {
                msg_no = 0x1129;
            } else if (mQst_CheckNpcExistbyItemIdx(sm_item->slot_no, mQst_CHECK_NPC_SENDER)) {
                msg_no = 0x112A;
            } else if (mQst_CheckFirstJobQuestbyItemIdx(sm_item->slot_no)) {
                msg_no = 0x112A;
            } else {
                mIN_copy_name_str(item_name, sm_item->item);
                mMsg_Set_free_str_art(msg_p, mMsg_FREE_STR0, item_name, mIN_ITEM_NAME_LEN,
                                      mIN_get_item_article(sm_item->item));
                msg_no = 0x112B;
                mQst_ClearQuestbyPossessionIdx(sm_item->slot_no);
                mPr_SetPossessionItem(Now_Private, sm_item->slot_no, EMPTY_NO, mPr_ITEM_COND_NORMAL);
            }

            if (msg_no != -1) {
                mMsg_Set_ForceNext(msg_p);
                mMsg_request_main_appear_wait_type1(msg_p);
                mMsg_Set_continue_msg_num(msg_p, msg_no);
            }

            aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);
            shrine->structure_class.arg0 = 0;
            break;
        }
    }
}

static void aSHR_make_hem_init(SHRINE_ACTOR* shrine) {
    mDemo_Set_talk_return_demo_wait(TRUE);
    mPlib_Set_able_force_speak_label((ACTOR*)shrine);
}

static void aSHR_make_hem(SHRINE_ACTOR* shrine, GAME_PLAY* play) {
    if (shrine->structure_class.actor_class.parent_actor == NULL) {
        if (mMsg_Check_MainDisappear(mMsg_Get_base_window_p()) && Common_Get(clip).npc_clip != NULL &&
            Common_Get(clip).npc_clip->setupActor_proc != NULL) {
            int made_hem = (*Common_Get(clip).npc_clip->setupActor_proc)(
                play, SP_NPC_HEM, -1, -1, -1, shrine->structure_class.actor_class.block_x,
                shrine->structure_class.actor_class.block_z, 7, 8);

            if (made_hem == TRUE) {
                ACTOR* hem_actor = Actor_info_fgName_search(&play->actor_info, SP_NPC_HEM, ACTOR_PART_NPC);

                if (hem_actor != NULL) {
                    xyz_t pos = shrine->structure_class.actor_class.world.position;

                    hem_actor->parent_actor = (ACTOR*)shrine;
                    aSHR_GET_CLIP()->hem_flag = TRUE;
                    Common_Set(hem_visible, FALSE);
                    pos.z += mFI_UT_WORLDSIZE_Z_F;
                    eEC_CLIP->effect_make_proc(eEC_EFFECT_MAKE_HEM, pos, 2, 0, (GAME*)play, 0xFFFF, 1, 0);
                    mSC_trophy_set(mSC_TROPHY_GOLDEN_AXE);
                    mFAs_ClearGoodField(); /* Only one player can get it at a time */
                    aSHR_setup_action(shrine, play, aSHR_ACTION_TALK_END);

                    if (mPlib_Check_able_force_speak_label((GAME*)play, (ACTOR*)shrine)) {
                        mPlib_Set_able_force_speak_label(hem_actor);
                    }
                }
            }
        }
    }
}

